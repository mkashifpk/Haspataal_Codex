{
  "screen": {
    "id": "death_register",
    "workspace": "owner_dashboard",
    "title": "Death register & mortality",
    "purpose": "The death register, the month's mortality statistics and the deaths to review; authorize clinical autopsies.",
    "workflow": "MSDS IMS 153, 154; 103, 105, 106",
    "rule_objects": [
      {
        "id": "rule:91d5d8d9b1",
        "text": "Statistics default to this month (date_from / date_to to change): tiles for gross and net death rates, deaths within 24 / 48 hours of admission, post-operative deaths, deaths within 48 hours of an operation (the anaesthesia screen), maternal, neonatal, brought dead, medico-legal; tables by setting, manner, department and the top underlying causes (ICD categories, with their titles).",
        "cites": []
      },
      {
        "id": "rule:7edb40cffa",
        "text": "review_list is the mortality meeting's agenda (unexpected and maternal deaths are sentinel events, MSDS 106): each opens the death record.",
        "cites": [
          "MSDS 106"
        ]
      },
      {
        "id": "rule:6de3a9a514",
        "text": "An autopsy request (notification category autopsy_request) waits here: 'Authorize' certifies the death is not medico-legal, records the next of kin's consent (name, relationship, what was agreed) and names the prosector; the doctor who asked cannot authorize it (AUTOPSY_SELF_AUTHORIZED). Then print the order (print-payload?document=autopsy_order) for the prosector.",
        "cites": []
      },
      {
        "id": "rule:00c679a136",
        "text": "The register lists patient names: open it only for the hospital's own review.",
        "cites": []
      }
    ],
    "related_workflows": [
      "deaths-and-medico-legal-cases",
      "icd-coding",
      "incidents-and-sentinel-events"
    ]
  },
