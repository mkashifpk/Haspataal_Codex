      "access": {
        "authentication": "user",
        "permissions": [
          "death.record",
          "death.body.release",
          "death.register.view",
          "death.autopsy.authorize"
        ],
        "permissions_mode": "any",
        "who": "holders of death.record or death.body.release or death.register.view or death.autopsy.authorize",
        "roles_allowed": [
          "anaesthetist",
          "clinic_director",
          "clinical_specialist",
          "doctor",
          "head_nurse",
          "hospital_admin",
          "hospital_director",
          "owner",
