          "surgeon",
          "triage_nurse",
          "ward_nurse"
        ]
      }
    },
    {
      "endpoint": "POST /deaths/{death_id}/autopsy/authorize",
      "summary": "Authorize the clinical autopsy: non-medico-legal certificate, consent, order to the prosector",
      "access": {
        "authentication": "user",
        "permissions": [
          "death.autopsy.authorize"
        ],
        "permissions_mode": "all",
        "who": "holders of death.autopsy.authorize",
        "roles_allowed": [
          "clinic_director",
          "hospital_admin",
          "hospital_director",
          "owner"
        ]
      },
      "write": {
        "protection": "state_guard",
        "on_lost_answer": "A repeat is refused with AUTOPSY_TRANSITION_INVALID: the autopsy has moved on. The first call may have succeeded; this error does not replay its result. Never retry automatically; re-read the record, then offer the action again only if it is still needed.",
        "reconcile_with": "GET /deaths/{death_id}",
        "refused_with": "AUTOPSY_TRANSITION_INVALID",
        "emits_events": [
          "notification.created"
        ],
        "prints": false,
        "related_state_machine": null
      }
    },
    {
      "endpoint": "POST /deaths/{death_id}/autopsy/cancel",
      "summary": "Cancel the autopsy request",
      "access": {
        "authentication": "user",
        "permissions": [
          "death.record",
          "death.autopsy.authorize"
        ],
        "permissions_mode": "any",
        "who": "holders of death.record or death.autopsy.authorize",
        "roles_allowed": [
          "anaesthetist",
          "clinic_director",
          "clinical_specialist",
          "doctor",
          "hospital_admin",
          "hospital_director",
          "owner",
          "surgeon"
        ]
      },
      "write": {
        "protection": "idempotency_key",
        "on_lost_answer": "If the original call sent an Idempotency-Key, retry with the SAME key and payload within its 24-hour retention: the server answers the first result again (header Idempotent-Replay: true). A new key means a new action. Without the original key, or after retention, re-read first; never automatically resubmit.",
        "reconcile_with": "GET /deaths/{death_id}",
        "emits_events": [],
        "prints": false,
        "related_state_machine": null
      }
    },
    {
      "endpoint": "GET /deaths/{death_id}/print-payload",
      "summary": "Printable death certificate, or the order for a clinical autopsy",
      "access": {
        "authentication": "user",
        "permissions": [
          "death.record",
          "death.body.release",
          "death.register.view",
          "death.autopsy.authorize"
        ],
        "permissions_mode": "any",
        "who": "holders of death.record or death.body.release or death.register.view or death.autopsy.authorize",
        "roles_allowed": [
          "anaesthetist",
          "clinic_director",
          "clinical_specialist",
          "doctor",
          "head_nurse",
          "hospital_admin",
          "hospital_director",
          "owner",
          "quality_officer",
          "surgeon",
          "triage_nurse",
          "ward_nurse"
        ]
      }
    },
    {
      "endpoint": "GET /deaths/{death_id}/pdf",
      "summary": "The death certificate or the autopsy order as a PDF",
      "access": {
        "authentication": "user",
        "permissions": [
          "death.record",
          "death.body.release",
          "death.register.view",
          "death.autopsy.authorize"
        ],
        "permissions_mode": "any",
