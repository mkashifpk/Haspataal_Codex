          "clinical_specialist",
          "doctor",
          "head_nurse",
          "lab_admin",
          "lab_technician",
          "lab_verifier",
          "radiologist",
          "receptionist",
          "surgeon",
          "ward_nurse"
        ]
      },
      "service_gates": [],
      "idempotency_key": false,
      "errors": [
        {
          "code": "VALIDATION_ERROR",
          "http_status": 422,
          "message": "The request is invalid.",
          "retryable": false,
          "ui_action": "Show field errors from details.fields / the message.",
          "source": [
            "documented"
          ],
          "details_fields": [],
          "details_from": "PUT /api/v1/admin/badge-stations/{station_id}"
        }
      ],
      "parameters": [
        {
          "name": "requisition_id",
          "in": "path",
          "required": true,
          "description": "",
          "schema": {
            "type": "integer",
            "title": "Requisition Id"
          }
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/Envelope_LabRequisitionDetailOut_"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      },
      "list": {
        "returns": "object",
        "paging": [],
        "search": [],
        "filters": [],
        "note": null
      }
    }
  ]
}
