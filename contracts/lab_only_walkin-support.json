{
  "endpoints": [
    {
      "endpoint": "GET /finance/invoices/{invoice_id}",
      "access": {
        "authentication": "user",
        "permissions": [
          "finance.invoice.view"
        ],
        "permissions_mode": "all",
        "who": "holders of finance.invoice.view",
        "roles_allowed": [
          "accountant",
          "admissions_officer",
          "billing_admin",
          "cashier",
          "clinic_director",
          "hospital_admin",
          "hospital_director",
          "owner",
          "pharmacist",
          "receptionist"
        ]
      },
      "parameters": [
        {
          "name": "invoice_id",
          "in": "path",
          "required": true,
          "description": "",
          "schema": {
            "type": "integer",
            "title": "Invoice Id"
          }
        }
      ],
      "responses": {
        "title": "Envelope[InvoiceDetailOut]",
        "properties": {
          "data": {
            "title": "InvoiceDetailOut",
            "properties": {
              "invoice_id": {
                "type": "integer",
                "title": "Invoice Id"
              },
              "invoice_no": {
                "type": "string",
                "title": "Invoice No"
              },
              "invoice_type": {
                "type": "string",
                "enum": [
                  "OPD",
                  "IPD",
                  "Pharmacy",
                  "Lab",
                  "Imaging",
                  "OT",
                  "OTC",
                  "Other"
                ],
                "title": "Invoice Type"
              },
              "patient_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Patient Id"
              },
              "admission_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Admission Id"
              },
              "ticket_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Ticket Id"
              },
              "panel_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Panel Id"
              },
              "employee_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Employee Id"
              },
              "walkin_customer_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Walkin Customer Name"
              },
              "walkin_customer_mobile": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Walkin Customer Mobile"
              },
              "gross_total": {
                "type": "number",
                "title": "Gross Total"
              },
              "discount_total": {
                "type": "number",
                "title": "Discount Total"
              },
              "net_payable": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Net Payable",
                "description": "Null while the invoice is a draft"
              },
              "amount_paid": {
                "type": "number",
                "title": "Amount Paid"
              },
              "amount_refunded": {
                "type": "number",
                "title": "Amount Refunded"
              },
              "waiver_amount": {
                "type": "number",
                "title": "Waiver Amount"
              },
              "waiver_dispensed_amount": {
                "type": "number",
                "title": "Waiver Dispensed Amount"
              },
              "credit_amount": {
                "type": "number",
                "title": "Credit Amount"
              },
              "status": {
                "type": "string",
                "enum": [
                  "Draft",
                  "Open",
                  "PartiallyPaid",
                  "Paid",
                  "CreditAuthorized",
                  "Waivered",
                  "Refunded",
                  "Cancelled"
                ],
                "title": "Status"
              },
              "is_locked": {
                "type": "boolean",
                "title": "Is Locked",
                "description": "Locked while an approval (waiver, credit, refund) is pending"
              },
              "locked_reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Locked Reason"
              },
              "finalized_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Finalized At"
              },
              "business_date": {
                "type": "string",
                "format": "date",
                "title": "Business Date"
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "title": "Created At"
              },
              "row_version": {
                "type": "integer",
                "title": "Row Version"
              },
              "lines": {
                "items": {
                  "$ref": "#/components/schemas/InvoiceLineOut"
                },
                "type": "array",
                "title": "Lines"
              },
              "balance_due": {
                "type": "number",
                "title": "Balance Due"
              }
            },
            "type": "object",
            "required": [
              "invoice_id",
              "invoice_no",
              "invoice_type",
              "patient_id",
              "admission_id",
              "ticket_id",
              "panel_id",
              "employee_id",
              "walkin_customer_name",
              "walkin_customer_mobile",
              "gross_total",
              "discount_total",
              "net_payable",
              "amount_paid",
              "amount_refunded",
              "waiver_amount",
              "waiver_dispensed_amount",
              "credit_amount",
              "status",
              "is_locked",
              "locked_reason",
              "finalized_at",
              "business_date",
              "created_at",
              "row_version",
              "lines",
              "balance_due"
            ],
            "description": "An invoice with its lines and what is still due (billing.invoice_with_lines)."
          },
          "meta": {
            "title": "Meta",
            "properties": {
              "server_time": {
                "type": "string",
                "title": "Server Time",
                "description": "Server clock (UTC). Use it to detect terminal clock skew."
              },
              "page": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Page"
              },
              "page_size": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Page Size"
              },
              "total_count": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Total Count"
              },
              "next_cursor": {
                "title": "Next Cursor"
              }
            },
            "type": "object",
            "required": [
              "server_time"
            ]
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta",
          "request_id"
        ]
      },
      "description": "**Required permission:** `finance.invoice.view`\n\n**Required permission:** `finance.invoice.view`"
    },
    {
