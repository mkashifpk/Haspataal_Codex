    },
    {
      "view": "open_work",
      "set_up": "GET /establishment answers views.screens[screen_id=lab_bench].view = open_work (laboratory): stub that answer, or have the DEV server's admin move the service on Facility settings",
      "expect": "The service is Retiring: show it with the banner 'No new <new_work> from now on' and its open work; hide the actions that start new work of it (x-capability-gates; continues_while_retiring ones stay); keep every other action (completing, transferring, settling, correcting)."
    },
    {
      "view": "records",
      "set_up": "GET /establishment answers views.screens[screen_id=lab_bench].view = records (laboratory): stub that answer, or have the DEV server's admin move the service on Facility settings",
