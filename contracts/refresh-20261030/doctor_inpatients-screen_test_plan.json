  "delivery_gate": {
    "required": true,
    "status": "required",
    "progress_reporting": {
      "required": true,
      "submit": "propose_progress",
      "verify": "progress_proposals",
      "when": "After each implemented screen, before switching workspace or handoff. Propose only tested items; identify the build and limitations. Do not duplicate unchanged pending/accepted work. Human approval still required."
    },
    "rule": "A screen or workspace is unfinished until its working UI, F1 contextual help, English/Urdu screen handbook,\nworkspace guide and detailed FAQ for every supported role, bounded 100-250% keyboard zoom, frontend coverage checks,\nand named human review of fresh, newly created data and supported CRUD operations are complete. Follow the workspace review\nchecklist (guide 17). Missing evidence stays pending; seeded-demo browsing, API tests or screenshots alone do not\nestablish completion. Agents propose evidence; only authenticated human review accepts progress.",
    "compulsory": [
      {
        "id": "q:f1_help",
        "label": "F1 contextual help",
        "what": "F1 opens the correct permitted help, including from fields/dialogs, preserves unsaved work and restores focus. Visible Help also works; login/locked/kiosk help exposes only public/operator guidance.",
        "points": 2
      },
      {
        "id": "q:role_faq",
        "label": "Complete role-specific FAQs",
        "what": "Every supported role task in this workspace, including shared screens and handovers, has a detailed reviewed English/Urdu FAQ. Follow get_handbook_outline; a generic FAQ or an unreviewed role journey is unfinished.",
        "points": 3
      },
      {
        "id": "q:zoom",
        "label": "Keyboard zoom: 100-250% only",
        "what": "Ctrl++/Ctrl+=, Ctrl+- and Ctrl+0 (Command on macOS), Settings and all enabled zoom routes share one state clamped to 100-250%. Test both bounds, reset, persistence and usable English/Urdu layouts at 250%.",
        "points": 2
      },
      {
        "id": "q:fresh_data",
        "label": "Human review with newly created data",
        "what": "A named human follows guide 17 on this build: creates new synthetic records through the UI and verifies read, update/correction and permitted delete/cancel/deactivate paths, refusal paths and handovers. Read-only screens use fresh upstream records. Record IDs and evidence; pre-existing demo data alone is insufficient.",
        "points": 4
      }
    ],
    "zoom": {
      "min_pct": 100,
      "max_pct": 250,
      "reset_pct": 100,
      "keys": [
        "Ctrl + or Ctrl = (zoom in)",
        "Ctrl - (zoom out)",
        "Ctrl 0 (reset to 100 %)",
        "Command on macOS"
      ],
      "one_state": "The keys, the Settings slider and any menu, wheel or pinch zoom move ONE zoom state, clamped to 100.0-250.0 %, saved as ui_scale_pct (PUT /settings/me) and restored at login (/auth/me preferences). Electron: webContents.setZoomFactor(pct / 100)."
    },
    "workspace_done_when": "Every screen of the workspace has every compulsory item above, in addition to its endpoints, events and rules: F1 contextual Help, a detailed FAQ for every role of the workspace (English and Urdu), the bounded keyboard zoom and a named human's review with newly created data (get_guide('workspace-review-checklist')), signed on the portal. Missing any one, the workspace is NOT done: report it as pending, never as complete.",
    "read": "get_ui_quality_brief(screen_id=...) or get_ui_quality_brief(workspace=...)"
  },
  "handbook_page": "screens/doctor_inpatients",
  "workspace_guide": "get_handbook_outline('doctor')",
  "realtime": [
    {
      "event": "admission.overflow_assigned",
      "check": "the screen refreshes without polling"
    },
    {
      "event": "admission.doctor_changed",
      "check": "the screen refreshes without polling"
    },
    {
      "event": "admission.discharge.stage_changed",
      "check": "the screen refreshes without polling"
    },
    {
      "event": "vitals.due",
      "check": "the screen refreshes without polling"
    }
  ],
  "acceptance_rules": [
    "Head every patient with the reason for admission and the provisional diagnosis, and who recorded them (details_stamp.text). A Code Red admission without them (admission_reason null) shows a red 'Record reason and diagnosis' task: POST .../admission-details, once; the clinical discharge needs them (ADMISSION_DETAILS_REQUIRED).",
    "Show the Patient Photo (photo_document_id) beside the name when there is one, for the identity check; none is normal (it is optional). 'Reports brought by the patient' lists the documents with is_outside, labelled with their facility and date, apart from this hospital's results.",
    "A patient who died: open the death record screen ('Record death'); later clinical edits are flagged for review.",
    "'Discharge' needs the signed discharge summary (DISCHARGE_SUMMARY_REQUIRED: open the summary screen) and the general consent of the admission (CONSENT_REQUIRED: open the consents screen).",
    "'Discharge' does NOT free the bed; show which clearance stage it is blocked on (blocked_on).",
    "My patients are the admissions whose primary_doctor_id is mine. A Code Red without a doctor (primary_doctor_id null: a triage nurse pressed it) shows to every doctor under 'Waiting for a doctor' with its 'Record reason and diagnosis' task: recording them makes you its doctor. Never show the person who pressed Code Red as the doctor.",
    "vitals.due for one of my patients: mark its vitals due or overdue (overdue_minutes) and re-read GET /admissions/{admission_id}/flowsheet (is_overdue) when it is open; the server decides due and overdue, and the nurse records them (no recording here).",
    "'Hand over to another doctor' on my patient: the doctor (GET /staff/lookup?license_type=PMDC) and the reason, then POST /admissions/{admission_id}/treating-doctor with an Idempotency-Key; it takes effect at once and the patient leaves my rounds (admission.doctor_changed). 'Take this patient' on a Code Red waiting for a doctor (GET /ipd/treating-doctors?waiting=true) names me. Show who looked after the patient before (GET /admissions/{admission_id}/treating-doctor: changes). TREATING_DOCTOR_ONLY: the patient is another doctor's; ask them, or the Hospital Admin while they are away.",
    "Exists for the service inpatient (work): show it as GET /establishment views.screens says for screen_id doctor_inpatients (full; open_work: without its new work, with the banner \"No new ... from now on\"; records: history and corrections only; setup: only from Facility settings; hidden: in no menu), after login and again on establishment.changed. Never decide it from the profile's category."
  ],
  "demo_accounts": "demo_accounts() lists a login per role; sandbox_call runs each case on the DEV server"
}
