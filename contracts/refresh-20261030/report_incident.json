      "request": {
        "content_type": "application/json",
        "model": "IncidentIn",
        "fields": [
          {
            "pointer": "/type_code",
            "type": "string",
            "required": true,
            "nullable": false,
            "description": "From GET /incident-types"
          },
          {
            "pointer": "/kind",
            "type": "string",
            "required": false,
            "nullable": false,
            "enum": [
              "Incident",
              "NearMiss"
            ],
            "default": "Incident",
            "description": "NearMiss: caught before it reached anyone"
          },
          {
            "pointer": "/harm",
            "type": "string",
            "required": false,
            "nullable": false,
            "enum": [
              "NoHarm",
              "Mild",
              "Moderate",
              "Severe",
              "Death"
            ],
            "default": "NoHarm"
          },
          {
            "pointer": "/occurred_at",
            "type": "string",
            "required": true,
            "nullable": false,
            "format": "date-time"
          },
          {
            "pointer": "/affected",
            "type": "string",
            "required": true,
            "nullable": false,
            "enum": [
              "Patient",
              "Staff",
              "Visitor",
              "None"
            ]
          },
          {
            "pointer": "/patient_id",
            "type": "integer",
            "required": false,
            "nullable": true
          },
          {
            "pointer": "/admission_id",
            "type": "integer",
            "required": false,
            "nullable": true,
            "description": "The admission it happened in (the patient follows from it)"
          },
          {
            "pointer": "/employee_id",
            "type": "integer",
            "required": false,
            "nullable": true,
            "description": "The staff member harmed (affected Staff)"
          },
          {
            "pointer": "/booking_id",
            "type": "integer",
            "required": false,
            "nullable": true,
            "description": "A theatre adverse event: the operation (with ot_phase)"
          },
          {
            "pointer": "/ot_phase",
            "type": "string",
            "required": false,
            "nullable": true,
            "enum": [
              "BeforeInduction",
              "Induction",
              "Maintenance",
              "Emergence",
              "Recovery",
              "AfterRecovery"
            ]
          },
          {
            "pointer": "/drug_id",
            "type": "integer",
            "required": false,
            "nullable": true,
            "description": "A medication error or an adverse drug reaction: the medicine"
          },
          {
            "pointer": "/medication_stage",
            "type": "string",
            "required": false,
            "nullable": true,
            "enum": [
              "Prescribing",
              "Transcribing",
              "Dispensing",
              "Administration",
              "Monitoring"
            ]
          },
          {
            "pointer": "/death_id",
            "type": "integer",
            "required": false,
            "nullable": true,
            "description": "An unexpected death: the death record"
          },
          {
            "pointer": "/department_id",
            "type": "integer",
            "required": false,
            "nullable": true
          },
          {
            "pointer": "/ward_id",
            "type": "integer",
            "required": false,
            "nullable": true
          },
          {
            "pointer": "/location",
            "type": "string",
            "required": false,
            "nullable": true,
            "max_length": 300
          },
          {
            "pointer": "/description",
            "type": "string",
            "required": true,
            "nullable": false,
            "min_length": 10,
            "max_length": 8000,
            "description": "What happened: facts, not opinions or blame"
          },
          {
            "pointer": "/immediate_action",
            "type": "string",
            "required": true,
            "nullable": false,
            "min_length": 3,
            "max_length": 4000,
            "description": "What was done at once for the person and to make the place safe"
          },
          {
            "pointer": "/screening_key",
            "type": "string",
            "required": false,
            "nullable": true,
            "description": "Reporting what the screening list found (GET /incident-screening)"
          },
          {
            "pointer": "/reporter_confidential",
            "type": "boolean",
            "required": false,
            "nullable": false,
            "default": false,
            "description": "Only the incident managers see who reported it"
          }
        ],
        "cross_field_rules": {
          "IncidentIn": [
            "A near miss reached nobody: harm is NoHarm",
            "A theatre adverse event gives the operation (booking_id) and the phase (ot_phase)",
            "Say which staff member was harmed (employee_id)",
            "An incident that concerns a patient is reported with affected Patient"
          ]
        },
        "note": "Constraints come from the schema; cross_field_rules are the model validators' own messages (enforced by the server: validate them on screen too). Labels, widgets and masks are yours."
      },
      "write": {
        "protection": "idempotency_key",
        "on_lost_answer": "If the original call sent an Idempotency-Key, retry with the SAME key and payload within its 24-hour retention: the server answers the first result again (header Idempotent-Replay: true). A new key means a new action. Without the original key, or after retention, re-read first; never automatically resubmit.",
