  "rules_in_force": null,
  "decisions": [
    {
      "id": "H02",
      "question": "Digits in the Urdu UI and printouts: Latin 0-9 or Extended Arabic-Indic ۰-۹.",
      "owner": [
        "vendor"
      ],
      "affects": [
        "every screen in Urdu"
      ],
      "meanwhile": "Latin digits; identifiers, doses and money stay left to right."
    },
    {
      "id": "H03",
      "question": "How dates and times are shown on screen, and a 12- or 24-hour clock.",
      "owner": [
        "vendor",
        "clinical_lead"
      ],
      "affects": [
        "every screen"
      ],
      "meanwhile": "The server's print format (e.g. 27-Sep-2026) and the hospital time zone."
    },
    {
      "id": "H04",
      "question": "Money on screen: decimals shown, and digit grouping (1,234,567 or 12,34,567).",
      "owner": [
        "vendor"
      ],
      "affects": [
        "every screen with money"
      ],
      "meanwhile": "The amounts as the API sends them, with the currency setting."
    },
    {
      "id": "H08",
      "question": "Who writes and signs off the Urdu text of the UI, above all clinical and consent wording.",
      "owner": [
        "vendor",
        "translator",
        "clinical_lead"
      ],
      "affects": [
        "every screen in Urdu"
      ],
      "meanwhile": "Urdu you add is a draft: mark it so (the interview bank's pattern: a draft until a native speaker reviews it)."
    },
    {
      "id": "H09",
      "question": "One design system shared by every frontend team (who authors and approves it), or each team's own.",
      "owner": [
        "vendor",
        "frontend_lead"
      ],
      "affects": [
        "every screen"
      ],
      "meanwhile": "Each team designs within the backend's constraints: themes Light and DarkHighContrast, zoom 100-250 %, Noto Nastaliq Urdu, status shown as text and icon, never colour alone. Follow the vendor's design principles (frontend guide 18, get_design_principles)."
    },
    {
      "id": "H10",
      "question": "How each realtime event is shown (interrupt, attention, inform, silent), alert sounds and which terminals play them. Only Code Red (interrupt), the licence and maintenance banners and the logout on session.revoked are prescribed (the event catalogue's `presentation`).",
      "owner": [
        "clinical_lead",
        "vendor"
      ],
      "affects": [
        "every screen with realtime events"
      ],
      "meanwhile": "Code Red interrupts; every other event updates the screen and, at most, a dismissible notice. `priority` is the delivery urgency, not a presentation rule."
    },
    {
      "id": "H12",
      "question": "Which workspaces run on web, Android and iOS, which cannot read a MAC address, discover the server by UDP or print silently; or are cash and printing Windows-only.",
      "owner": [
        "vendor",
        "backend"
      ],
      "affects": [
        "my_cash_shift",
        "registration",
        "every screen that prints"
      ],
      "meanwhile": "The guides describe the Windows (Electron) terminal; tell your developer when a screen needs a capability your platform lacks."
    },
    {
      "id": "H18",
      "question": "Noto Nastaliq Urdu everywhere, or the more compact Naskh in dense tables.",
      "owner": [
        "vendor",
        "frontend_lead"
      ],
      "affects": [
        "every table in Urdu"
      ],
      "meanwhile": "Noto Nastaliq Urdu, as the guides require."
    },
    {
      "id": "H19",
      "question": "Allergies: the patient record keeps free text, so it cannot tell \"no known allergies\" (asserted by a clinician) from \"not recorded\". Should it?",
      "owner": [
        "clinical_lead",
        "backend"
      ],
      "affects": [
        "every screen with a patient banner"
      ],
      "meanwhile": "Show the recorded text as recorded; an empty value is \"not recorded\", never \"none\"."
    },
    {
      "id": "H20",
      "question": "May unsaved form input be kept on the terminal (which fields, encrypted, for how long)?",
      "owner": [
        "vendor",
        "hospital"
      ],
      "affects": [
        "every form"
      ],
      "meanwhile": "In memory only; never a second checker's password."
    },
    {
      "id": "H22",
      "question": "Which documents may print on an unregistered terminal's default printer (sensitive A4 documents).",
      "owner": [
        "hospital",
        "vendor"
      ],
      "affects": [
        "every screen that prints"
      ],
      "meanwhile": "As the printing guide says: the hint, then the default printer."
    },
    {
      "id": "H24",
      "question": "Who approves frontend performance targets, alert thresholds and escalation timers.",
      "owner": [
        "vendor",
        "clinical_lead"
      ],
      "affects": [
        "every screen"
      ],
      "meanwhile": "The server's own settings (e.g. critical_result_communicate_minutes)."
    }
  ],
