{
  "method": "POST",
  "path": "/api/v1/consents",
  "summary": "Prepare a consent form",
  "tags": [
    "Consent"
  ],
  "permissions": [
    "consent.record"
  ],
  "permissions_mode": "all",
  "idempotency_key": true,
  "description": "A draft on a form of the list (`form_code`), in the patient's language (`CONSENT_TEXT_MISSING` when the form has\nno text in it: `details.available`), for an admission (the general consent needs one), an operation, an ER visit or\nan OPD visit. Prefilled: from the operation, the procedure and the surgeon (the anaesthesia: the technique and the\nanaesthetist of the assessment); from the admission, the need for admission. `missing` lists what the explanation\nstill lacks. Then print it (`GET /consents/{consent_id}/print-payload`) and explain it.\nAn id in the request body that does not exist: `REFERENCE_NOT_FOUND` (details.field).\n\n`OT_BOOKING_STATE_INVALID`: the operation (`booking_id`) is cancelled or completed.\n\n**Required permission:** `consent.record`\n\n**Required permission:** `consent.record`",
  "roles_allowed": [
    "admissions_officer",
    "anaesthetist",
    "clinical_specialist",
    "doctor",
    "head_nurse",
    "surgeon",
    "triage_nurse",
    "ward_nurse"
  ],
  "parameters": [
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
  "request_body": {
    "title": "ConsentIn",
    "properties": {
      "procedure_name": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "null"
          }
        ],
        "title": "Procedure Name",
        "examples": [
          "Open appendicectomy"
        ]
      },
      "performer_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Performer Id",
        "description": "The employee who performs it (fills performer_name)"
      },
      "performer_name": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 300
          },
          {
            "type": "null"
          }
        ],
        "title": "Performer Name",
        "examples": [
          "Dr Ahmed and the surgical team"
        ]
      },
      "risks": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4000
          },
          {
            "type": "null"
          }
        ],
        "title": "Risks",
        "examples": [
          "Wound infection, bleeding, injury to the bowel, a hernia at the scar later; rarely a second operation"
        ]
      },
      "benefits": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4000
          },
          {
            "type": "null"
          }
        ],
        "title": "Benefits",
        "examples": [
          "Removes the inflamed appendix before it bursts"
        ]
      },
      "alternatives": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4000
          },
          {
            "type": "null"
          }
        ],
        "title": "Alternatives",
        "examples": [
          "Antibiotics alone (the appendicitis may come back); laparoscopic operation"
        ]
      },
      "admission_need": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ],
        "title": "Admission Need",
        "description": "General consent: why the patient is admitted"
      },
      "estimated_days": {
        "anyOf": [
          {
            "type": "integer",
            "maximum": 365,
            "minimum": 0
          },
          {
            "type": "null"
          }
        ],
        "title": "Estimated Days",
        "description": "General consent: the estimated stay"
      },
      "estimated_cost": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
          },
          {
            "type": "null"
          }
        ],
        "title": "Estimated Cost",
        "description": "General consent: the estimated cost (PKR)"
      },
      "form_code": {
        "type": "string",
        "title": "Form Code",
        "description": "The form of the hospital's list (GET /consent-forms)",
        "examples": [
          "OPERATION"
        ]
      },
      "language": {
        "type": "string",
        "enum": [
          "English",
          "Urdu",
          "Punjabi",
          "Saraiki",
          "Pashto",
          "Sindhi",
          "Balochi"
        ],
        "title": "Language",
        "description": "The language the patient understands; the form must have a text in it"
      },
      "patient_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Patient Id",
        "description": "Default: the patient of the admission, operation or visit"
      },
      "admission_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Admission Id",
        "description": "Required for the general consent; default: the operation's"
      },
      "booking_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Booking Id",
        "description": "The operation (consents to the operation and to its anaesthesia)"
      },
      "er_visit_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Er Visit Id"
      },
      "ticket_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Ticket Id",
        "description": "An OPD visit (a procedure in the clinic)"
      }
    },
    "type": "object",
    "required": [
      "form_code",
      "language"
    ]
  },
