{
  "screen": {
    "id": "record_review_overview",
    "workspace": "owner_dashboard",
    "title": "Medical record review (MSDS)",
    "purpose": "The quarterly medical record review: plan and follow cycles, read the surveyor's report.",
    "workflow": "MSDS IMS-3 (156-162)",
    "rule_objects": [
      {
        "id": "rule:338133b2d4",
        "text": "Start from GET /quality/record-review/status: `next_due` names the period to review (a quarter by default); 'Plan review' pre-fills it (POST /quality/record-reviews with no period).",
        "cites": []
      },
      {
        "id": "rule:48266a93af",
        "text": "Panel picker = GET /quality/record-review/people (can_review). Show each reviewer's discipline: MSDS 158 wants doctors AND nurses, never only the records staff.",
        "cites": [
          "MSDS 158"
        ]
      },
      {
        "id": "rule:f5168043b0",
        "text": "Before 'Start', show GET .../sample-plan as a table (department x state: population, sample) with the formula line; after the start the sample and period are frozen (say so on the button's confirmation).",
        "cites": []
      },
      {
        "id": "rule:376b13b9aa",
        "text": "Progress bar per reviewer (reviewers[].assigned / reviewed), live with record_review.updated. Records with no reviewer (everyone on the panel wrote in them) need 'Assign' to a new panel member.",
        "cites": []
      },
      {
        "id": "rule:ae8d532fe1",
        "text": "'Close' asks for the minutes. Show the three refusals as a checklist before enabling it: all reviewed, no open deficiency, an action recorded when deficiencies were found.",
        "cites": []
      },
      {
        "id": "rule:80b0f59dc0",
        "text": "The report is the surveyor's evidence: print it (A4). Put the MSDS block first: one row per indicator 156-162 with Met (green) / PartlyMet (amber) / NotMet (red) and the evidence text.",
        "cites": []
      },
      {
        "id": "rule:b5f80216fd",
        "text": "Records appear by record number and MRN only; never add patient names to this screen or its printout.",
        "cites": []
      },
      {
        "id": "rule:d3796b0405",
        "text": "'Print' = GET .../report/pdf (A4, the MSDS block first); it is also the record_review_report of the inspection pack.",
        "cites": []
      },
      {
        "id": "rule:03e2f92d13",
        "text": "Deficiencies: Acknowledge (true but cannot be undone, e.g. a late note) or Withdraw (not a deficiency); authors mark their own Corrected from their workspace.",
        "cites": []
      },
      {
        "id": "rule:bd15655f09",
        "text": "Actions: type, owner (GET /quality/record-review/people), due date; they join the hospital's action register (GET /quality/actions?source=RecordReview); overdue ones in red (is_overdue).",
        "cites": []
      },
      {
        "id": "rule:4c9ae06af8",
        "text": "Checklist editor: built-in items (auto_check set) can be reworded or retired, not deleted; the hospital's own items are answered by the reviewer.",
        "cites": []
      }
    ],
    "related_workflows": [
      "clinic-quality-and-education",
      "complaints",
      "duty-rosters-and-attendance",
      "facility-and-it",
      "facility-compliance-equipment-drills",
      "finance-and-owner",
      "hr-and-payroll",
      "incidents-and-sentinel-events",
      "infection-control",
      "medical-record-review",
      "personnel-records",
      "phc-interview-prep",
      "quality-indicators-and-committees"
    ]
  },
