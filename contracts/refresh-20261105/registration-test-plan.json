  "service_cases": [
    {
      "call": "POST /api/v1/reception/registrations",
      "set_up": "emergency_department not Active in GET /establishment",
      "expect": "the choice for an emergency patient (source Emergency) without an open emergency visit is hidden or disabled; the rest of the action stays"
    }
  ],
  "delivery_gate": {
    "required": true,
    "status": "required",
    "progress_reporting": {
      "required": true,
      "submit": "propose_progress",
      "verify": "progress_proposals",
      "when": "After each implemented screen, before switching workspace or handoff. Propose only tested items; identify the build and limitations. Do not duplicate unchanged pending/accepted work. Human approval still required."
    },
    "rule": "A screen or workspace is unfinished until its working UI, F1 contextual help, English/Urdu screen handbook,\nworkspace guide and detailed FAQ for every supported role, bounded 100-250% keyboard zoom, frontend coverage checks,\nand named human review of fresh, newly created data and supported CRUD operations are complete. Follow the workspace review\nchecklist (guide 17). Missing evidence stays pending; seeded-demo browsing, API tests or screenshots alone do not\nestablish completion. Agents propose evidence; only authenticated human review accepts progress.",
    "compulsory": [
      {
        "id": "q:f1_help",
        "label": "F1 contextual help",
        "what": "F1 opens the correct permitted help, including from fields/dialogs, preserves unsaved work and restores focus. Visible Help also works; login/locked/kiosk help exposes only public/operator guidance.",
        "points": 2
      },
      {
        "id": "q:role_faq",
        "label": "Complete role-specific FAQs",
        "what": "Every supported role task in this workspace, including shared screens and handovers, has a detailed reviewed English/Urdu FAQ. Follow get_handbook_outline; a generic FAQ or an unreviewed role journey is unfinished.",
        "points": 3
      },
      {
        "id": "q:zoom",
        "label": "Keyboard zoom: 100-250% only",
        "what": "Ctrl++/Ctrl+=, Ctrl+- and Ctrl+0 (Command on macOS), Settings and all enabled zoom routes share one state clamped to 100-250%. Test both bounds, reset, persistence and usable English/Urdu layouts at 250%.",
        "points": 2
      },
      {
        "id": "q:fresh_data",
        "label": "Human review with newly created data",
        "what": "A named human follows guide 17 on this build: creates new synthetic records through the UI and verifies read, update/correction and permitted delete/cancel/deactivate paths, refusal paths and handovers. Read-only screens use fresh upstream records. Record IDs and evidence; pre-existing demo data alone is insufficient.",
        "points": 4
      }
    ],
    "zoom": {
      "min_pct": 100,
      "max_pct": 250,
      "reset_pct": 100,
      "keys": [
        "Ctrl + or Ctrl = (zoom in)",
        "Ctrl - (zoom out)",
        "Ctrl 0 (reset to 100 %)",
        "Command on macOS"
      ],
      "one_state": "The keys, the Settings slider and any menu, wheel or pinch zoom move ONE zoom state, clamped to 100.0-250.0 %, saved as ui_scale_pct (PUT /settings/me) and restored at login (/auth/me preferences). Electron: webContents.setZoomFactor(pct / 100)."
    },
    "workspace_done_when": "Every screen of the workspace has every compulsory item above, in addition to its endpoints, events and rules: F1 contextual Help, a detailed FAQ for every role of the workspace (English and Urdu), the bounded keyboard zoom and a named human's review with newly created data (get_guide('workspace-review-checklist')), signed on the portal. Missing any one, the workspace is NOT done: report it as pending, never as complete.",
    "read": "get_ui_quality_brief(screen_id=...) or get_ui_quality_brief(workspace=...)"
  },
  "handbook_page": "screens/registration",
  "workspace_guide": "get_handbook_outline('reception')",
  "realtime": [
    {
      "event": "opd.queue.updated",
      "check": "the screen refreshes without polling"
    }
  ],
  "acceptance_rules": [
    "Always send an Idempotency-Key header: one UUID per registration the user starts, the same one on every retry of it (a second click after a lost answer is a retry), so a retry never double-charges.",
    "Only name, gender, age/DOB and mobile are required for Regular patients; CNIC optional.",
    "Patient Photo is OPTIONAL here and everywhere (never a required field, never a blocker): offer 'Take photo' (camera) or 'Choose file' (JPEG or PNG), preview, retake, and 'Skip' needing no reason. Ask first; respect a refusal (purdah, privacy) and never delay an emergency, an injured face or a patient who cannot cooperate. Upload it after the patient exists: POST /patients/{patient_id}/documents doc_type=Photo, its own Idempotency-Key, so a failed upload never repeats a registration, a payment or an admission. Show photo_document_id (patient, admission) through GET /patient-documents/{document_id}/download.",
    "'Reports brought by the patient' (optional, any number): file (PDF, or a JPEG/PNG scan or photo of the paper), type (LabReport, Imaging, DischargeSummary, Prescription, ReferralLetter, Other), title (the test or report, e.g. 'CBC'), issued by (source_facility, required) and the date on it (document_date) → POST /patients/{patient_id}/documents with is_outside=true. List them labelled 'Outside: <facility>, <date>', apart from this hospital's own results: they are never shown or counted as this hospital's lab or imaging results.",
    "Discount above the user's ceiling → DISCOUNT_CEILING_EXCEEDED (details.max_pct): issue the ticket within the ceiling, then offer 'Request VIP waiver' with waiver_pct for the rest (Billing Admin / Owner approve).",
    "AR_OUTSTANDING_BLOCK: show the dues banner; Emergency source bypasses the block.",
    "Print print_payload.text on the 80 mm thermal printer mapped to this terminal (GET /terminals/whoami).",
    "The doctor: from GET /opd-queues/doctors (by department, with how many wait), or the department alone; a colleague who sees no OPD queue answers VALIDATION_ERROR (details.field doctor_id). A patient sent to the wrong doctor is re-routed by that doctor: the dashboard moves the patient by itself (opd.queue.updated).",
    "POST /reception/registrations starts new emergency_department work for an emergency patient (source Emergency) without an open emergency visit: offer that choice only while emergency_department is Active (GET /establishment active); the rest of the action stays."
  ],
  "demo_accounts": "demo_accounts() lists a login per role; sandbox_call runs each case on the DEV server"
}
