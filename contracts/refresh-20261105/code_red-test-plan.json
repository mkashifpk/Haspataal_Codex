  "service_cases": [
    {
      "view": "full",
      "set_up": "GET /establishment answers views.screens[screen_id=code_red].view = full (inpatient): stub that answer, or have the DEV server's admin move the service on Facility settings",
      "expect": "Show it; every action the user's permissions allow."
    },
    {
      "view": "open_work",
      "set_up": "GET /establishment answers views.screens[screen_id=code_red].view = open_work (inpatient): stub that answer, or have the DEV server's admin move the service on Facility settings",
      "expect": "The service is Retiring: show it with the banner 'No new <new_work> from now on' and its open work; hide the actions that start new work of it (x-capability-gates; continues_while_retiring ones stay); keep every other action (completing, transferring, settling, correcting)."
    },
    {
      "view": "records",
      "set_up": "GET /establishment answers views.screens[screen_id=code_red].view = records (inpatient): stub that answer, or have the DEV server's admin move the service on Facility settings",
      "expect": "The service is Retired (or Preparing after it ran): show it as records only, under a 'Records' marker: lists, details, prints and the corrections the server still accepts; no action that starts new work."
    },
    {
      "view": "hidden",
      "set_up": "GET /establishment answers views.screens[screen_id=code_red].view = hidden (inpatient): stub that answer, or have the DEV server's admin move the service on Facility settings",
      "expect": "Not in any menu: the service has never run here, so the screen has nothing to show."
    },
    {
      "call": "POST /api/v1/admissions/code-red",
      "set_up": "inpatient not Active in GET /establishment",
      "expect": "the action is hidden"
    },
    {
      "call": "POST /api/v1/admissions/code-red",
      "set_up": "emergency_department not Active in GET /establishment",
      "expect": "the choice unless the patient has an open emergency visit is hidden or disabled; the rest of the action stays"
    },
    {
      "call": "POST /api/v1/admissions/code-red",
      "set_up": "surgery not Active in GET /establishment",
      "expect": "the choice with needs_ot (the emergency theatre hold) is hidden or disabled; the rest of the action stays"
    }
  ],
  "delivery_gate": {
    "required": true,
    "status": "required",
    "progress_reporting": {
      "required": true,
      "submit": "propose_progress",
      "verify": "progress_proposals",
      "when": "After each implemented screen, before switching workspace or handoff. Propose only tested items; identify the build and limitations. Do not duplicate unchanged pending/accepted work. Human approval still required."
    },
    "rule": "A screen or workspace is unfinished until its working UI, F1 contextual help, English/Urdu screen handbook,\nworkspace guide and detailed FAQ for every supported role, bounded 100-250% keyboard zoom, frontend coverage checks,\nand named human review of fresh, newly created data and supported CRUD operations are complete. Follow the workspace review\nchecklist (guide 17). Missing evidence stays pending; seeded-demo browsing, API tests or screenshots alone do not\nestablish completion. Agents propose evidence; only authenticated human review accepts progress.",
    "compulsory": [
      {
        "id": "q:f1_help",
        "label": "F1 contextual help",
        "what": "F1 opens the correct permitted help, including from fields/dialogs, preserves unsaved work and restores focus. Visible Help also works; login/locked/kiosk help exposes only public/operator guidance.",
        "points": 2
      },
      {
        "id": "q:role_faq",
        "label": "Complete role-specific FAQs",
        "what": "Every supported role task in this workspace, including shared screens and handovers, has a detailed reviewed English/Urdu FAQ. Follow get_handbook_outline; a generic FAQ or an unreviewed role journey is unfinished.",
        "points": 3
      },
      {
        "id": "q:zoom",
        "label": "Keyboard zoom: 100-250% only",
        "what": "Ctrl++/Ctrl+=, Ctrl+- and Ctrl+0 (Command on macOS), Settings and all enabled zoom routes share one state clamped to 100-250%. Test both bounds, reset, persistence and usable English/Urdu layouts at 250%.",
        "points": 2
      },
      {
        "id": "q:fresh_data",
        "label": "Human review with newly created data",
        "what": "A named human follows guide 17 on this build: creates new synthetic records through the UI and verifies read, update/correction and permitted delete/cancel/deactivate paths, refusal paths and handovers. Read-only screens use fresh upstream records. Record IDs and evidence; pre-existing demo data alone is insufficient.",
        "points": 4
      }
    ],
    "zoom": {
      "min_pct": 100,
      "max_pct": 250,
      "reset_pct": 100,
      "keys": [
        "Ctrl + or Ctrl = (zoom in)",
        "Ctrl - (zoom out)",
        "Ctrl 0 (reset to 100 %)",
        "Command on macOS"
      ],
      "one_state": "The keys, the Settings slider and any menu, wheel or pinch zoom move ONE zoom state, clamped to 100.0-250.0 %, saved as ui_scale_pct (PUT /settings/me) and restored at login (/auth/me preferences). Electron: webContents.setZoomFactor(pct / 100)."
    },
    "workspace_done_when": "Every screen of the workspace has every compulsory item above, in addition to its endpoints, events and rules: F1 contextual Help, a detailed FAQ for every role of the workspace (English and Urdu), the bounded keyboard zoom and a named human's review with newly created data (get_guide('workspace-review-checklist')), signed on the portal. Missing any one, the workspace is NOT done: report it as pending, never as complete.",
    "read": "get_ui_quality_brief(screen_id=...) or get_ui_quality_brief(workspace=...)"
  },
  "handbook_page": "screens/code_red",
  "workspace_guide": "get_handbook_outline('triage')",
  "realtime": [
    {
      "event": "admission.code_red",
      "check": "the screen refreshes without polling"
    }
  ],
  "acceptance_rules": [
    "Never block on billing or demographics in this flow, nor on the reason and diagnosis: the doctor records them once the patient is stable (inpatient rounds screen, admission-details). Billing is deferred, never waived: the admissions desk confirms it later (pending_admissions, confirm-billing).",
    "No photo in this flow: the Patient Photo is optional and may be taken later, once the patient is stable and agrees, from the admissions desk or the document vault.",
    "From an ER visit send its er_visit_id; the Code Red is recorded there as triage level 1 and the visit waits for the admission. Send is_medico_legal (+ mlc_case_type_id) if known; else ask it later on the ER visit.",
    "On admission.code_red at the DESTINATION terminal: flash red full-screen + audio chime with payload.message.",
    "Pharmacy and OT terminals receive the same alert.",
    "The answer's primary_doctor_id is the caller only when a doctor pressed the button; a nurse's Code Red shows 'Doctor: waiting' (null) until a doctor records the reason and diagnosis (decisions 57).",
    "Exists for the service inpatient (work): show it as GET /establishment views.screens says for screen_id code_red (full; open_work: without its new work, with the banner \"No new ... from now on\"; records: history and corrections only; setup: only from Facility settings; hidden: in no menu), after login and again on establishment.changed. Never decide it from the profile's category.",
    "POST /admissions/code-red starts new inpatient work: offer it only while inpatient is Active (GET /establishment active).",
    "POST /admissions/code-red starts new emergency_department work unless the patient has an open emergency visit: offer that choice only while emergency_department is Active (GET /establishment active); the rest of the action stays.",
    "POST /admissions/code-red starts new surgery work with needs_ot (the emergency theatre hold): offer that choice only while surgery is Active (GET /establishment active); the rest of the action stays."
  ],
  "demo_accounts": "demo_accounts() lists a login per role; sandbox_call runs each case on the DEV server"
}
