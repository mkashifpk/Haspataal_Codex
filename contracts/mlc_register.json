  "screen": {
    "id": "mlc_register",
    "workspace": "owner_dashboard",
    "title": "Medico-legal register & setup",
    "purpose": "The MLC register (the surveyor asks for it), the hospital's medico-legal case types and its contact list of police stations and MLR hospitals.",
    "workflow": "MSDS indicators 15, 16",
    "rule_objects": [
      {
        "id": "rule:6457bb13c1",
        "text": "Register filters: status, dates, case type, police station, overdue (police not informed in time: notification category mlc_police_intimation).",
        "cites": []
      },
      {
        "id": "rule:f4041c4189",
        "text": "Setup: the case types are the hospital's SOP list (MSDS 15 vi a); the contact list holds the local police stations and the hospitals designated for medico-legal reports and post-mortems (15 vi b). Retire entries with is_active false; never delete.",
        "cites": [
          "MSDS 15"
        ]
      },
      {
        "id": "rule:5080f32b90",
        "text": "The same list is the emergency and referral contact list a clinic displays (its manual, indicator 30): referral hospitals, the health office, the trauma centre, the blood bank, the rescue service, the fire brigade, police emergency 15 and Rescue 1122 (both seeded), ambulances, social services. 'Print for display' = GET /mlc/contacts/pdf.",
        "cites": []
      }
    ],
    "related_workflows": [
      "deaths-and-medico-legal-cases",
      "emergency-department",
      "external-referrals",
      "inpatient-and-discharge",
      "maternity-and-newborns"
    ]
  },
