    }
  ],
  "acceptance_rules": [
    "Show ticket.cash_back_prompts as a blocking modal with the exact amount until confirmed.",
    "Cash leaves YOUR open shift drawer (open one first: SHIFT_NOT_OPEN)."
  ],
