{
  "screen": {
    "id": "owner_diagnostics",
    "workspace": "owner_dashboard",
    "title": "Diagnostic services quality (MSDS)",
    "purpose": "The turnaround, the critical results, rejected samples, repeated images, the partners' record and the written lab and imaging policies: the evidence a surveyor asks for.",
    "workflow": "MSDS AAC 1-14",
    "rule_objects": [
      {
        "id": "rule:667ea148d4",
        "text": "Turnaround (service Lab or Imaging, a period): per class the results due, on time and the percentage against target_pct (95 routine, 100 emergency); `score` FullyMet / PartiallyMet / NotMet as the MSDS scores AAC 4 and 11; by_item per test or modality; late with their delay_reason.",
        "cites": []
      },
      {
        "id": "rule:d2540368ad",
        "text": "Statistics: one row per `measures` item with its MSDS reference (red below 100 where the standard wants every one), the lab and imaging scores, rejections and repeats by reason, each partner's on-time record.",
        "cites": []
      },
      {
        "id": "rule:4d6cc4acce",
        "text": "Print for the surveyor: the turnaround PDF, the critical results register, the laboratory policy, the imaging policy and quality assurance plan, the list of diagnostic services (to display).",
        "cites": []
      },
      {
        "id": "rule:0a674814e6",
        "text": "Exists for the service laboratory or outsourced_diagnostics or imaging (records): show it as GET /establishment views.screens says for screen_id owner_diagnostics (full; open_work: without its new work, with the banner \"No new ... from now on\"; records: history and corrections only; setup: only from Facility settings; hidden: in no menu), after login and again on establishment.changed. Never decide it from the profile's category.",
        "cites": []
      }
    ],
    "related_workflows": [
      "diagnostic-services",
      "inpatient-and-discharge",
      "laboratory-and-radiology"
    ],
    "service": {
      "services": [
        "laboratory",
        "outsourced_diagnostics",
        "imaging"
      ],
      "role": "records",
      "views": {
        "full": "Show it; every action the user's permissions allow.",
        "open_work": "The service is Retiring: show it with the banner 'No new <new_work> from now on' and its open work; hide the actions that start new work of it (x-capability-gates; continues_while_retiring ones stay); keep every other action (completing, transferring, settling, correcting).",
        "records": "The service is Retired (or Preparing after it ran): show it as records only, under a 'Records' marker: lists, details, prints and the corrections the server still accepts; no action that starts new work.",
        "setup": "Not in the daily menus: reach it from Facility settings (a preview's prerequisites link to it) to set the service up before switching it on.",
        "hidden": "Not in any menu: the service has never run here, so the screen has nothing to show."
      },
      "how": "GET /establishment after login and on establishment.changed: views.screens gives this screen's view (one frontend build for every profile; never decide it from the profile's category)"
    }
  },
