{
  "screen_id": "otc",
  "endpoints": [
    {
      "endpoint": "GET /dispensations/{dispensation_id}/receipt-payload",
      "summary": "Pharmacy receipt print payload",
      "access": {
        "authentication": "user",
        "permissions": [
          "pharmacy.dispense",
          "pharmacy.otc.sell"
        ],
        "permissions_mode": "any",
        "who": "holders of pharmacy.dispense or pharmacy.otc.sell",
        "roles_allowed": [
          "pharmacist"
        ]
      },
      "parameters": [
        {
          "name": "dispensation_id",
          "in": "path",
          "required": true,
          "description": "",
          "schema": {
            "type": "integer",
            "title": "Dispensation Id"
          }
        }
      ],
      "responses": {
        "title": "Envelope[PrintOut[PharmacyReceiptFieldsOut]]",
        "properties": {
          "data": {
            "title": "PrintOut[PharmacyReceiptFieldsOut]",
            "properties": {
              "document_type": {
                "type": "string",
                "enum": [
                  "autopsy_order",
                  "bed_labels",
                  "blood_component_label",
                  "blood_donation_labels",
                  "clinical_note",
                  "complaint_letter",
                  "complaints_notice",
                  "consent_form",
                  "cost_estimate",
                  "cssd_labels",
                  "death_certificate",
                  "discharge_summary",
                  "dispensing_label",
                  "dose_label",
                  "id_card",
                  "imaging_report",
                  "lab_label",
                  "lab_report",
                  "mlc_intimation",
                  "opd_slip",
                  "pharmacy_receipt",
                  "prescription",
                  "referral_slip",
                  "send_out_manifest",
                  "surgical_record",
                  "triage_algorithm",
                  "wristband"
                ],
                "title": "Document Type"
              },
              "printer_role": {
                "type": "string",
                "enum": [
                  "receipt",
                  "label",
                  "document",
                  "card"
                ],
                "title": "Printer Role",
                "description": "Which printer of the terminal to use (GET /api/v1/terminals/whoami)"
              },
              "paper_width_mm": {
                "type": "integer",
                "title": "Paper Width Mm"
              },
              "fields": {
                "$ref": "#/components/schemas/PharmacyReceiptFieldsOut",
                "description": "The document's data, for frontends that render their own layout"
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Text",
                "description": "Pre-formatted monospace text (48 columns) for ESC/POS printers, as is"
              },
              "barcode_svg": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Barcode Svg"
              },
              "qr_svg": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Qr Svg"
              },
              "pdf_url": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Pdf Url"
              }
            },
            "type": "object",
            "required": [
              "document_type",
              "printer_role",
              "paper_width_mm",
              "fields",
              "text",
              "barcode_svg",
              "qr_svg",
              "pdf_url"
            ]
          },
          "meta": {
            "title": "Meta",
            "properties": {
              "server_time": {
                "type": "string",
                "title": "Server Time",
                "description": "Server clock (UTC). Use it to detect terminal clock skew."
              },
              "page": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Page"
              },
              "page_size": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Page Size"
              },
              "total_count": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Total Count"
              },
              "next_cursor": {
                "title": "Next Cursor"
              }
            },
            "type": "object",
            "required": [
              "server_time"
            ]
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta",
          "request_id"
        ]
      },
      "description": "**Required permission:** `pharmacy.dispense OR pharmacy.otc.sell`\n\n**Required permission:** `pharmacy.dispense OR pharmacy.otc.sell`"
    }
  ]
}
