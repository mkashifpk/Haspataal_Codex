{
  "screen_id": "otc",
  "endpoints": [
    {
      "endpoint": "GET /dispensations/{dispensation_id}/receipt-payload",
      "summary": "Pharmacy receipt print payload",
      "access": {
        "authentication": "user",
        "permissions": [
          "pharmacy.dispense",
          "pharmacy.otc.sell"
        ],
        "permissions_mode": "any",
        "who": "holders of pharmacy.dispense or pharmacy.otc.sell",
        "roles_allowed": [
          "pharmacist"
        ]
      },
      "service_gates": [],
      "idempotency_key": false,
      "errors": [
        {
          "code": "VALIDATION_ERROR",
          "http_status": 422,
          "message": "The request is invalid.",
          "retryable": false,
          "ui_action": "Show field errors from details.fields / the message.",
          "source": [
            "documented"
          ],
          "details_fields": [],
          "details_from": "PUT /api/v1/admin/badge-stations/{station_id}"
        }
      ],
      "parameters": [
        {
          "name": "dispensation_id",
          "in": "path",
          "required": true,
          "description": "",
          "schema": {
            "type": "integer",
            "title": "Dispensation Id"
          }
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/Envelope_PrintOut_PharmacyReceiptFieldsOut__"
              }
            }
          }
        },
        "422": {
          "description": "Validation Error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HTTPValidationError"
              }
            }
          }
        }
      },
      "list": {
        "returns": "object",
        "paging": [],
        "search": [],
        "filters": [],
        "note": null
      },
      "prints": {
        "kind": "print_payload",
        "document_types": [
          "autopsy_order",
          "bed_labels",
          "blood_component_label",
          "blood_donation_labels",
          "clinical_note",
          "complaint_letter",
          "complaints_notice",
          "consent_form",
          "cost_estimate",
          "cssd_labels",
          "death_certificate",
          "discharge_summary",
          "dispensing_label",
          "dose_label",
          "id_card",
          "imaging_report",
          "lab_label",
          "lab_report",
          "mlc_intimation",
          "opd_slip",
          "pharmacy_receipt",
          "prescription",
          "referral_slip",
          "send_out_manifest",
          "surgical_record",
          "triage_algorithm",
          "wristband"
        ],
        "printer_role": "receipt",
        "document_type": "pharmacy_receipt",
        "paper_width_mm": 80,
        "server_renders": [
          "text",
          "barcode_svg"
        ],
        "rule": "Print `text` as is on receipt printers, `fields` in your own layout for A4, or download `pdf_url`; route by printer_role (GET /terminals/whoami). Right-to-left printouts are laid out by the terminal."
      }
    }
  ]
}
