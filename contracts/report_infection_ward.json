  "screen": {
    "id": "report_infection_ward",
    "workspace": "ward_nurse",
    "title": "Suspected infection and wound checks",
    "purpose": "Report a suspected healthcare-associated infection; record the wound checks after an operation.",
    "workflow": "MSDS IPC 84, COP 50",
    "rule_objects": [
      {
        "id": "rule:95c310ce14",
        "text": "Report a suspected infection (POST /infection-cases): the kind (a surgical site infection gives the operation and the depth), the onset, where it was found, the organism if known, the signs and the criteria met; the infection control team confirms or excludes it.",
        "cites": []
      },
      {
        "id": "rule:23b5e00588",
        "text": "Wound checks after an operation (POST /ot/bookings/{booking_id}/ssi-checks): on the ward round, at the OPD review or by telephone; 'Signs of infection' needs the note and the suspected depth and opens a case itself.",
        "cites": []
      },
      {
        "id": "rule:4c01a42a22",
        "text": "Exists for the service inpatient (work): show it as GET /establishment views.screens says for screen_id report_infection_ward (full; open_work: without its new work, with the banner \"No new ... from now on\"; records: history and corrections only; setup: only from Facility settings; hidden: in no menu), after login and again on establishment.changed. Never decide it from the profile's category.",
        "cites": []
      }
    ],
    "related_workflows": [
      "infection-control"
    ],
    "service": {
      "services": [
        "inpatient"
      ],
      "role": "work",
      "views": {
        "full": "Show it; every action the user's permissions allow.",
        "open_work": "The service is Retiring: show it with the banner 'No new <new_work> from now on' and its open work; hide the actions that start new work of it (x-capability-gates; continues_while_retiring ones stay); keep every other action (completing, transferring, settling, correcting).",
        "records": "The service is Retired (or Preparing after it ran): show it as records only, under a 'Records' marker: lists, details, prints and the corrections the server still accepts; no action that starts new work.",
        "setup": "Not in the daily menus: reach it from Facility settings (a preview's prerequisites link to it) to set the service up before switching it on.",
        "hidden": "Not in any menu: the service has never run here, so the screen has nothing to show."
      },
      "how": "GET /establishment after login and on establishment.changed: views.screens gives this screen's view (one frontend build for every profile; never decide it from the profile's category)"
    }
  },
