    {
      "id": "case:POST /auth/refresh",
      "call": "POST /api/v1/auth/refresh",
      "summary": "Rotate the refresh token and get a new access token",
      "happy_path": {
        "as_one_of": [
          "any logged-in user"
        ],
        "example": {
          "request": {
            "path": "/api/v1/auth/refresh",
            "body": {
              "refresh_token": "<redacted recorded credential>"
            }
          },
          "response": {
            "status": 200,
            "body": {
              "data": {
                "access_token": "<redacted recorded credential>",
                "token_type": "bearer",
                "expires_in": 1800,
                "refresh_token": "<redacted recorded credential>",
                "refresh_expires_in": 604800
              },
              "meta": {
                "server_time": "2026-09-27T17:35:04.474222+00:00"
              },
              "request_id": "bd27c25b976f451cbbc942671f9240f2"
            }
          },
          "errors_seen": [
            "LICENSE_INVALID",
            "REFRESH_TOKEN_REUSED",
            "TOKEN_REVOKED"
          ],
          "events_emitted": []
        }
      },
      "denied": {
        "as_one_of": [],
        "expect": "403 FORBIDDEN"
      },
      "errors_to_handle": [
        "ACCOUNT_DISABLED",
        "LICENSE_INVALID",
        "REFRESH_TOKEN_REUSED",
        "TOKEN_EXPIRED",
        "TOKEN_REVOKED",
