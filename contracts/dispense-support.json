        "permissions_mode": "any",
        "who": "holders of patient.own_medicine.record or patient.own_medicine.identify or prescription.view",
        "roles_allowed": [
          "anaesthetist",
          "clinical_specialist",
          "doctor",
          "head_nurse",
          "pharmacist",
          "pharmacy_admin",
          "surgeon",
          "ward_nurse"
