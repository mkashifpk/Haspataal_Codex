    {
      "method": "POST",
      "path": "/api/v1/rosters/roll-call",
      "summary": "Mark rostered staff present (no badge station)",
      "tags": [
        "Duty Rosters"
      ],
      "permissions": [
        "attendance.roll_call"
      ],
      "permissions_mode": "all",
      "idempotency_key": true,
      "description": "Records an `In` punch with source `RollCall` and you as the recorder for the duty on `roster_date`, then\nrecomputes that duty's flag (late / half day against the rostered shift). Staff who already punched for that\nduty are skipped. Only staff you may roster, and only if rostered that day (`ROLL_CALL_NOT_ROSTERED`).\nOpen for today's duties and for a night shift from yesterday that is still running; an earlier day's shift only for HR\nand with the real arrival time `at` (`ROSTER_DATE_CLOSED` for others), which must fall within the shift.\n`ROSTER_OUT_OF_SCOPE`: you may not roster this employee (outside your staff scope).\n\n**Required permission:** `attendance.roll_call`\n\n**Required permission:** `attendance.roll_call`",
      "roles_allowed": [
        "head_nurse",
        "hr_admin",
        "ops_admin"
      ],
      "parameters": [
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": false,
          "description": "Unique per logical action; retries return the first result",
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Unique per logical action; retries return the first result",
            "title": "Idempotency-Key"
          }
        }
      ],
      "request_body": {
        "title": "RollCallIn",
        "properties": {
          "roster_date": {
            "type": "string",
            "format": "date",
            "title": "Roster Date"
          },
          "present": {
            "items": {
              "title": "Present",
              "properties": {
                "employee_id": {
                  "type": "integer",
                  "title": "Employee Id"
                },
                "at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "At",
                  "description": "Arrival time; default now (required for an earlier day's shift). Without a UTC offset it is the hospital's local time"
                }
              },
              "type": "object",
              "required": [
                "employee_id"
              ]
            },
            "type": "array",
            "maxItems": 300,
            "minItems": 1,
            "title": "Present"
          }
        },
        "type": "object",
        "required": [
          "roster_date",
          "present"
        ]
      },
      "request_content_type": "application/json",
      "response_schema": {
        "title": "Envelope[RollCallOut]",
        "properties": {
          "data": {
            "title": "RollCallOut",
            "properties": {
              "roster_date": {
                "type": "string",
                "format": "date",
                "title": "Roster Date"
              },
              "recorded": {
                "items": {
                  "$ref": "#/components/schemas/AttendanceLogOut"
                },
                "type": "array",
                "title": "Recorded"
              },
              "skipped": {
                "items": {
                  "$ref": "#/components/schemas/RollCallSkippedOut"
                },
                "type": "array",
                "title": "Skipped",
                "description": "Staff who had already punched in"
              }
            },
            "type": "object",
            "required": [
              "roster_date",
              "recorded",
              "skipped"
            ]
          },
          "meta": {
            "title": "Meta",
            "properties": {
              "server_time": {
                "type": "string",
                "title": "Server Time",
                "description": "Server clock (UTC). Use it to detect terminal clock skew."
              },
              "page": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Page"
              },
              "page_size": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Page Size"
              },
              "total_count": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Total Count"
              },
              "next_cursor": {
                "title": "Next Cursor"
              }
            },
            "type": "object",
            "required": [
              "server_time"
            ]
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta",
          "request_id"
        ]
      },
