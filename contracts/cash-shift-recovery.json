{
  "contract_fingerprint": "a48efc9c8254ac5137e2",
  "knowledge_revision": "5d997abd8847f89d",
  "source": "MCP get_endpoint GET /finance/cash-shifts/{shift_id}, 2026-10-25",
  "endpoints": [
    {
      "endpoint": "GET /finance/cash-shifts/{shift_id}",
      "summary": "Shift summary (expected cash by transaction type)",
      "access": {
        "authentication": "user",
        "permissions": [
          "finance.shift.operate",
          "finance.shift.view_all"
        ],
        "permissions_mode": "any",
        "who": "holders of finance.shift.operate or finance.shift.view_all",
        "roles_allowed": [
          "accountant",
          "cashier",
          "clinic_director",
          "hospital_admin",
          "hospital_director",
          "owner",
          "pharmacist",
          "receptionist"
        ]
      },
      "parameters": [
        {
          "name": "shift_id",
          "in": "path",
          "required": true,
          "description": "",
          "schema": {
            "type": "integer",
            "title": "Shift Id"
          }
        }
      ],
      "idempotency_key": false,
      "responses": {
        "200": {
          "description": "Successful Response",
          "content": {
            "application/json": {
              "schema": {
                "title": "Envelope[CashShiftSummaryOut]",
                "properties": {
                  "data": {
                    "title": "CashShiftSummaryOut",
                    "properties": {
                      "shift_id": {
                        "type": "integer",
                        "title": "Shift Id"
                      },
                      "user_id": {
                        "type": "integer",
                        "title": "User Id"
                      },
                      "node": {
                        "type": "string",
                        "enum": [
                          "MainReception",
                          "PharmacyCounter",
                          "LabReception",
                          "IPDBilling",
                          "EmergencyCounter",
                          "CashierDesk"
                        ],
                        "title": "Node",
                        "description": "The cash counter"
                      },
                      "terminal_id": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Terminal Id"
                      },
                      "opening_float": {
                        "type": "number",
                        "title": "Opening Float",
                        "description": "The cash the drawer started with, issued from the main vault: the drawer's first entry (OpeningFloat)"
                      },
                      "expected_cash": {
                        "type": "number",
                        "title": "Expected Cash",
                        "description": "What the drawer should hold now: the opening float plus every cash movement of the shift (by_type). Count all of it at the close. 0 once the verified cash drop has taken it to the vault (cash_drop.expected_cash keeps the amount)"
                      },
                      "declared_cash": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Declared Cash",
                        "description": "What the cashier counted in the whole drawer at the close, the float included (null while open)"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "Open",
                          "PendingCollection",
                          "Verified"
                        ],
                        "title": "Status"
                      },
                      "opened_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Opened At"
                      },
                      "closed_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Closed At"
                      },
                      "business_date": {
                        "type": "string",
                        "format": "date",
                        "title": "Business Date"
                      },
                      "cashier_name": {
                        "type": "string",
                        "title": "Cashier Name"
                      },
                      "declared_variance": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Declared Variance",
                        "description": "declared_cash minus what the drawer held at the close, its float included (null until the shift is closed)"
                      },
                      "by_type": {
                        "items": {
                          "$ref": "#/components/schemas/ShiftTotalOut"
                        },
                        "type": "array",
                        "title": "By Type"
                      },
                      "non_cash": {
                        "items": {
                          "$ref": "#/components/schemas/NonCashTotalOut"
                        },
                        "type": "array",
                        "title": "Non Cash"
                      },
                      "cash_drop": {
                        "anyOf": [
                          {
                            "$ref": "#/components/schemas/CashDropOut"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "type": "object",
                    "required": [
                      "shift_id",
                      "user_id",
                      "node",
                      "terminal_id",
                      "opening_float",
                      "expected_cash",
                      "declared_cash",
                      "status",
                      "opened_at",
                      "closed_at",
                      "business_date",
                      "cashier_name",
                      "declared_variance",
                      "by_type",
                      "non_cash",
                      "cash_drop"
                    ],
                    "description": "A shift with the expected cash by transaction type, non-cash collections and its cash drop."
                  },
                  "meta": {
                    "title": "Meta",
                    "properties": {
                      "server_time": {
                        "type": "string",
                        "title": "Server Time",
                        "description": "Server clock (UTC). Use it to detect terminal clock skew."
                      },
                      "page": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Page"
                      },
                      "page_size": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Page Size"
                      },
                      "total_count": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "title": "Total Count"
                      },
                      "next_cursor": {
                        "title": "Next Cursor"
                      }
                    },
                    "type": "object",
                    "required": [
                      "server_time"
                    ]
                  },
                  "request_id": {
                    "type": "string",
                    "title": "Request Id"
                  }
                },
                "type": "object",
                "required": [
                  "data",
                  "meta",
                  "request_id"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "recorded_example": {
    "request": {
      "path": "/api/v1/finance/cash-shifts/1"
    },
    "response": {
      "status": 200,
      "body": {
        "data": {
          "shift_id": 1,
          "user_id": 3,
          "node": "MainReception",
          "terminal_id": null,
          "opening_float": 0,
          "expected_cash": 1000,
          "declared_cash": null,
          "status": "Open",
          "opened_at": "2026-10-24T18:22:17.225397+00:00",
          "closed_at": null,
          "business_date": "2026-10-24",
          "cashier_name": "Receptionist",
          "declared_variance": null,
          "by_type": [
            {
              "txn_type": "Sale",
              "count": 1,
              "total": 1000
            }
          ],
          "non_cash": [],
          "cash_drop": null
        },
        "meta": {
          "server_time": "2026-10-24T18:22:17.939040+00:00"
        },
        "request_id": "24d14d07f53d404fac6c4f067603b0f8"
      }
    }
  }
}
