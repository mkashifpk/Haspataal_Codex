{
  "screen_id": "charity_override",
  "endpoints": [
    {
      "endpoint": "GET /prescriptions/{prescription_id}",
      "summary": "Prescription with remaining quantities and stock per line",
      "access": {
        "authentication": "user",
        "permissions": [
          "prescription.view"
        ],
        "permissions_mode": "all",
        "who": "holders of prescription.view",
        "roles_allowed": [
          "anaesthetist",
          "clinical_specialist",
          "doctor",
          "head_nurse",
          "pharmacist",
          "surgeon",
          "ward_nurse"
        ]
      },
      "parameters": [
        {
          "name": "prescription_id",
          "in": "path",
          "required": true,
          "description": "",
          "schema": {
            "type": "integer",
            "title": "Prescription Id"
          }
        }
      ],
      "description": "**Required permission:** `prescription.view`\n\n**Required permission:** `prescription.view`"
    },
    {
      "endpoint": "GET /approvals/{request_id}",
      "summary": "One approval request",
      "access": {
        "authentication": "user",
        "permissions": [],
        "permissions_mode": "all",
        "who": "the request's requester or a holder of its required_permission; anyone else gets FORBIDDEN"
      },
      "parameters": [
        {
          "name": "request_id",
          "in": "path",
          "required": true,
          "description": "",
          "schema": {
            "type": "integer",
            "title": "Request Id"
          }
        }
      ],
      "description": "Open one request from the queue or from the requester's own list: the same people `GET /approvals` shows it to.\nAnyone else gets `FORBIDDEN` (the request holds the patient, the amount and the payload); `NOT_FOUND`: no such\nrequest."
    }
  ]
}
