          "type": "array",
          "title": "Permission Codes"
        }
      },
      "type": "object",
      "required": ["permission_codes"],
      "title": "PermissionsIn"
    },
    "StationIn": {
      "properties": {
        "station_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{2,64}$",
          "title": "Station Id",
          "examples": ["WARD3-KIOSK", "GATE-STAFF"]
        },
        "label": {
          "type": "string",
          "maxLength": 100,
          "minLength": 2,
          "title": "Label"
        },
        "device_type": {
          "type": "string",
          "enum": ["RFIDReader", "BarcodeScanner", "BiometricTerminal"],
          "title": "Device Type",
          "description": "The hardware; the API is the same for all (BarcodeScanner = kiosk PC/tablet reading printed QR badges)",
          "default": "RFIDReader"
        },
        "location_type": {
          "type": "string",
          "enum": [
            "Bed",
            "Ward",
            "Gate",
            "OT",
            "Pharmacy",
            "Lab",
            "StaffEntrance"
          ],
          "title": "Location Type"
        },
        "action_type": {
          "type": "string",
          "enum": ["AttendancePunch", "BedCleaned", "SecurityPass", "Generic"],
          "title": "Action Type"
        },
        "ward_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ward Id",
          "description": "BedCleaned without bed_id: the ward whose bed QR stickers this kiosk scans"
        },
        "bed_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bed Id",
          "description": "BedCleaned: the bed this station hangs at (or leave empty for a ward kiosk)"
        },
        "is_active": {
          "type": "boolean",
          "title": "Is Active",
          "default": true
        }
      },
      "type": "object",
      "required": ["station_id", "label", "location_type", "action_type"],
      "title": "StationIn"
    },
    "SettingIn": {
      "properties": {
        "value": {
          "title": "Value",
          "description": "JSON value of the same type as the current one"
        }
      },
      "type": "object",
      "required": ["value"],
      "title": "SettingIn"
    },
    "MaintenanceIn": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled"
        },
        "message": {
          "type": "string",
          "maxLength": 300,
          "title": "Message",
          "default": ""
        }
      },
      "type": "object",
      "required": ["enabled"],
      "title": "MaintenanceIn"
    },
    "KillSwitchIn": {
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 500,
          "minLength": 5,
          "title": "Reason"
        },
        "confirm": {
          "type": "string",
          "const": "FORCE GLOBAL LOGOUT",
          "title": "Confirm",
          "description": "Type exactly \"FORCE GLOBAL LOGOUT\" (dangerous, emergency only)"
        }
      },
      "type": "object",
      "required": ["reason", "confirm"],
      "title": "KillSwitchIn"
    },
    "BedsIn": {
      "properties": {
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 200,
          "minItems": 1,
          "title": "Labels",
          "examples": [["B-1", "B-2", "B-3"]]
        },
        "is_overflow_allowed": {
          "type": "boolean",
          "title": "Is Overflow Allowed",
          "default": false
        }
      },
      "type": "object",
      "required": ["labels"],
      "title": "BedsIn"
    },
    "TheaterIn": {
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 20,
          "minLength": 2,
          "title": "Code",
          "examples": ["OT1"]
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 2,
          "title": "Name",
          "examples": ["Main OT 1"]
        },
        "theater_type": {
          "type": "string",
          "title": "Theater Type",
          "default": "General",
          "examples": ["General", "Cardiac", "Orthopedic"]
        }
      },
      "type": "object",
      "required": ["code", "name"],
      "title": "TheaterIn"
    },
    "FirstOwnerIn": {
      "properties": {
        "full_name": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1,
          "title": "Full Name",
          "examples": ["Dr. Ayesha Malik"]
        },
        "cnic": {
          "type": "string",
          "pattern": "^[0-9]{5}-?[0-9]{7}-?[0-9]$",
          "title": "Cnic",
          "description": "Required of every member of staff (§6.1)",
          "examples": ["35202-1234567-1"]
        },
        "mobile": {
          "type": "string",
          "pattern": "^\\+?[0-9][0-9 -]{6,19}$",
          "title": "Mobile",
          "examples": ["0300-1234567"]
        },
        "gender": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["male", "female", "other"]
            },
            {
              "type": "null"
            }
          ],
          "title": "Gender"
        },
        "dob": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dob"
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "designation": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "title": "Designation",
          "default": "Owner"
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9._-]{3,64}$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Username",
          "description": "Suggested from the name if omitted"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 10,
          "title": "Roles",
          "description": "Roles besides owner (always given), e.g. ['hr_admin'] or, in a small clinic, ['hr_admin', 'doctor']; never super_admin or phc_inspector"
        }
      },
      "type": "object",
      "required": ["full_name", "cnic", "mobile"],
      "title": "FirstOwnerIn"
    },
    "ChangeRequestIn": {
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["Setting", "UserRoles", "RolePermissions"],
          "title": "Kind"
        },
        "setting_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Setting Key"
        },
        "target_user_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target User Id"
        },
        "target_role_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Role Code"
