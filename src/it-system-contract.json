  "schemas": {
    "DepartmentIn": {
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 20,
          "minLength": 2,
          "title": "Code"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 2,
          "title": "Name"
        },
        "is_clinical": {
          "type": "boolean",
          "title": "Is Clinical",
          "default": false
        },
        "is_active": {
          "type": "boolean",
          "title": "Is Active",
          "default": true
        }
      },
      "type": "object",
      "required": ["code", "name"],
      "title": "DepartmentIn"
    },
    "WardIn": {
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 20,
          "minLength": 2,
          "title": "Code"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 2,
          "title": "Name"
        },
        "ward_type": {
          "type": "string",
          "enum": [
            "General",
            "Private",
            "SemiPrivate",
            "ICU",
            "CCU",
            "NICU",
            "Surgical",
            "Pediatric",
            "Maternity",
            "Emergency",
            "Isolation",
            "Other"
          ],
          "title": "Ward Type"
        },
        "gender_restriction": {
          "type": "string",
          "enum": ["male", "female", "any"],
          "title": "Gender Restriction",
          "default": "any"
        },
        "department_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Department Id"
        },
        "room_charge_service_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Room Charge Service Id",
          "description": "Per bed-day charge (service catalog, category RoomCharge)"
        },
        "is_active": {
          "type": "boolean",
          "title": "Is Active",
          "default": true
        }
      },
      "type": "object",
      "required": ["code", "name", "ward_type"],
      "title": "WardIn"
    },
    "PrinterIn": {
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 2,
          "title": "Name",
          "examples": ["Lab Requisition Printer B"]
        },
        "printer_type": {
          "type": "string",
          "enum": [
            "ThermalReceipt",
            "BarcodeLabel",
            "PVCCard",
            "Laser",
            "Other"
          ],
          "title": "Printer Type"
        },
        "connection": {
          "type": "string",
          "enum": ["USB", "Network", "Shared", "Bluetooth", "Other"],
          "title": "Connection"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Address",
          "description": "OS printer name, \\\\PC\\Printer or 192.168.1.40:9100"
        },
        "paper_width_mm": {
          "anyOf": [
            {
              "type": "integer",
              "maximum": 400,
              "minimum": 30
            },
            {
              "type": "null"
            }
          ],
          "title": "Paper Width Mm"
        },
        "driver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Driver"
        },
        "is_active": {
          "type": "boolean",
          "title": "Is Active",
          "default": true
        }
      },
      "type": "object",
      "required": ["name", "printer_type", "connection"],
      "title": "PrinterIn"
    },
    "TerminalIn": {
      "properties": {
        "mac": {
          "type": "string",
          "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
          "title": "Mac",
          "examples": ["3C:52:82:1A:2B:3C"]
        },
        "ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ip",
          "examples": ["192.168.1.15"]
        },
        "hostname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hostname"
        },
        "location_label": {
          "type": "string",
          "maxLength": 100,
          "minLength": 2,
          "title": "Location Label",
          "examples": ["Lab Reception PC 2"]
        },
        "department_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Department Id"
        },
        "receipt_printer_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Receipt Printer Id"
        },
        "label_printer_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label Printer Id"
        },
        "document_printer_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Document Printer Id"
        },
        "card_printer_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Card Printer Id"
        },
        "cash_node": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "MainReception",
                "PharmacyCounter",
                "LabReception",
                "IPDBilling",
                "EmergencyCounter",
                "CashierDesk"
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Cash Node"
        },
        "is_active": {
          "type": "boolean",
          "title": "Is Active",
          "default": true
        }
      },
      "type": "object",
      "required": ["mac", "location_label"],
      "title": "TerminalIn"
    },
    "ProvisionIn": {
      "properties": {
        "employee_id": {
          "type": "integer",
          "title": "Employee Id"
        },
        "username": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9._-]{3,64}$"
            },
            {
              "type": "null"
            }
          ],
          "title": "Username",
          "description": "Suggested from the name if omitted"
        },
        "role_codes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1,
          "title": "Role Codes",
          "description": "Multi-select checklist, e.g. ['clinical_specialist','hospital_admin']"
        }
      },
      "type": "object",
      "required": ["employee_id", "role_codes"],
      "title": "ProvisionIn"
    },
    "RolesIn": {
      "properties": {
        "role_codes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1,
          "title": "Role Codes"
        }
      },
      "type": "object",
      "required": ["role_codes"],
      "title": "RolesIn"
    },
    "ActiveIn": {
      "properties": {
        "active": {
          "type": "boolean",
          "title": "Active"
        },
        "reason": {
          "type": "string",
          "maxLength": 300,
          "minLength": 3,
          "title": "Reason"
        }
      },
      "type": "object",
      "required": ["active", "reason"],
      "title": "ActiveIn"
    },
    "PermissionsIn": {
      "properties": {
        "permission_codes": {
          "items": {
            "type": "string"
