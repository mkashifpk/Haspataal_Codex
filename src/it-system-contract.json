        "requested_value": {
          "title": "Requested Value",
          "description": "Setting: the new value; UserRoles: role codes; RolePermissions: permission codes"
        },
        "reason": {
          "type": "string",
          "maxLength": 500,
          "minLength": 3,
          "title": "Reason"
        }
      },
      "type": "object",
      "required": ["kind", "requested_value", "reason"],
      "title": "ChangeRequestIn"
    }
  }
}
