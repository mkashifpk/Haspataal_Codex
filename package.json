{
  "name": "haspataal-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:help && tsc --noEmit && vite build",
    "check:help": "node scripts/check-help.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/live-check.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "test:foundation": "node scripts/foundation-check.mjs",
    "test:registration": "node scripts/registration-check.mjs"
  },
  "dependencies": {
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.9.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
