                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Zone Label",
              "examples": [
                "Bay A",
                "Main gate",
                "OPD corridor"
              ]
            },
            "bed_ids": {
              "items": {
                "type": "integer"
              },
              "type": "array",
              "maxItems": 60,
              "title": "Bed Ids",
              "description": "Ward duties: the beds this nurse looks after"
            },
            "is_on_call": {
              "type": "boolean",
              "title": "Is On Call",
              "default": false
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string",
