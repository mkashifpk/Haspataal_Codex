{
  "method": "POST",
  "path": "/api/v1/rosters",
  "summary": "Roster one or many duties (all or nothing)",
  "tags": [
    "Duty Rosters"
  ],
  "permissions": [
    "roster.manage.all",
    "roster.manage.nursing",
    "roster.manage.support"
  ],
  "permissions_mode": "any",
  "idempotency_key": true,
  "description": "Refused, with `details.entry_index`, when an entry is outside your scope (`ROSTER_OUT_OF_SCOPE`), overlaps\nanother duty of the same person (`ROSTER_CONFLICT`, also for a night shift running into the next day), falls\non approved leave (`ROSTER_ON_LEAVE`), is for a past date and you are not HR (`ROSTER_DATE_CLOSED`) or names\nsomeone who is not an active employee (`ROSTER_EMPLOYEE_INACTIVE`). The rostered staff with a login get a\nnotification; every open planner gets `roster.changed`.\nAn id in the request body that does not exist: `REFERENCE_NOT_FOUND` (details.field).\n\n**Required permission:** `roster.manage.all OR roster.manage.nursing OR roster.manage.support`\n\n**Required permission:** `roster.manage.all OR roster.manage.nursing OR roster.manage.support`",
  "roles_allowed": [
    "head_nurse",
    "hr_admin",
    "ops_admin"
  ],
  "parameters": [
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
