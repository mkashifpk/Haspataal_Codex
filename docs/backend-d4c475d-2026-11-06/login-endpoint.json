{
  "method": "POST",
  "path": "/api/v1/auth/login",
  "summary": "Log in (returns tokens, profile, roles, workspaces)",
  "tags": [
    "Auth"
  ],
  "permissions": [],
  "permissions_mode": "all",
  "idempotency_key": false,
  "access": {
    "authentication": "public",
    "permissions": [],
    "permissions_mode": "all",
    "who": "public: no login (works before login)"
  },
  "description": "Returns an access token (30 min) and a refresh token (7 days, rotated on every use).\n\n* `must_change_password: true` → show the change-password form first; other endpoints\n  return `PASSWORD_CHANGE_REQUIRED` until then.\n* One workspace → open it; several → show the workspace picker (workflow §11.1).\n* Errors: `INVALID_CREDENTIALS`, `ACCOUNT_LOCKED` (details.retry_after_seconds),\n  `ACCOUNT_DISABLED`, `RATE_LIMITED`.\n\n`ACCOUNT_EXPIRED`: a time-limited login (the PHC inspector's guest account) after its last day.\n`LICENSE_INVALID`: the server's licence is not valid and its grace is over (`details`: state, reason,\ngrace_until, vendor): show it with the vendor's contact details; only IT's super administrator still signs in.",
  "roles_allowed": [],
  "parameters": [],
  "request_body": {
    "title": "LoginIn",
    "properties": {
      "username": {
        "type": "string",
        "maxLength": 64,
        "minLength": 3,
        "title": "Username",
        "examples": [
          "dr.ahmed"
        ]
      },
      "password": {
        "type": "string",
        "maxLength": 256,
        "minLength": 1,
        "title": "Password",
        "examples": [
          "S3cure-Pass!"
        ]
      },
      "terminal_label": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 100
          },
          {
            "type": "null"
          }
        ],
        "title": "Terminal Label",
        "description": "Optional terminal name shown in session lists"
      }
    },
    "type": "object",
    "required": [
      "username",
      "password"
    ]
  },
  "request_content_type": "application/json",
  "response_schema": {
    "title": "Envelope[LoginOut]",
    "properties": {
      "data": {
        "title": "LoginOut",
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "description": "Always bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Access token lifetime in seconds"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "refresh_expires_in": {
            "type": "integer",
            "title": "Refresh Expires In"
          },
          "user": {
            "$ref": "#/components/schemas/MeOut"
          },
          "license": {
            "$ref": "#/components/schemas/LicenseStatusOut",
            "description": "Show `message` as a banner while `state` is grace or locked"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "refresh_expires_in",
          "user",
          "license"
        ]
      },
      "meta": {
        "title": "Meta",
        "properties": {
          "server_time": {
            "type": "string",
            "title": "Server Time",
            "description": "Server clock (UTC). Use it to detect terminal clock skew."
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "page_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Size"
          },
          "total_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Count"
          },
          "next_cursor": {
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "server_time"
        ]
      },
      "request_id": {
        "type": "string",
        "title": "Request Id"
      }
    },
    "type": "object",
    "required": [
      "data",
      "meta",
      "request_id"
    ]
  },
