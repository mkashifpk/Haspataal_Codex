// Independent optional document requests must not block care for the same fixed patient.
export function hasBlockingWrite(markers: (string | null)[], allowedPatient?: number) {
  const allowed = Number.isSafeInteger(allowedPatient) && (allowedPatient || 0) > 0 ? String(allowedPatient) : undefined;
  return markers.some(marker => !allowed || marker !== allowed);
}
