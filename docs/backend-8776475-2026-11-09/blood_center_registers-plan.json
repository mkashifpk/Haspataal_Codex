      "expect": "Show it; every action the user's permissions allow."
    },
    {
      "view": "open_work",
      "set_up": "GET /establishment answers views.screens[screen_id=blood_center_registers].view = open_work (blood_center): stub that answer, or have the DEV server's admin move the service on Facility settings",
      "expect": "The service is Retiring: show it with the banner 'No new <new_work> from now on' and its open work; hide the actions that start new work of it (x-capability-gates; continues_while_retiring ones stay); keep every other action (completing, transferring, settling, correcting)."
    },
    {
      "view": "records",
      "set_up": "GET /establishment answers views.screens[screen_id=blood_center_registers].view = records (blood_center): stub that answer, or have the DEV server's admin move the service on Facility settings",
      "expect": "The service is Retired (or Preparing after it ran): show it as records only, under a 'Records' marker: lists, details, prints and the corrections the server still accepts; no action that starts new work."
    },
    {
      "view": "hidden",
      "set_up": "GET /establishment answers views.screens[screen_id=blood_center_registers].view = hidden (blood_center): stub that answer, or have the DEV server's admin move the service on Facility settings",
