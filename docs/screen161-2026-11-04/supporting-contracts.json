  "wards": {
    "method": "GET",
    "path": "/api/v1/beds/matrix",
    "summary": "Live bed matrix (counts per ward + optional bed list)",
    "tags": [
      "IPD"
    ],
    "permissions": [
      "ipd.bed.view",
      "cssd.operate",
      "infection.control.manage"
    ],
    "permissions_mode": "any",
    "idempotency_key": false,
    "description": "Keep live with `bed.state_changed`. Patient names are included only for users who can\nview admissions. The sterile supply (`cssd.operate`) and infection control (`infection.control.manage`) read it for\nits wards: where packs are issued and audits held (backend issue #41). Every bed listed belongs to a ward in `wards` (the open wards): a closed ward (deactivated in the\nIT console, `PUT /admin/wards/{ward_id}`) leaves the matrix with its beds and its counts, and comes back when it\nis reopened. A ward closed meanwhile shows in an allocation's `BED_NO_LONGER_AVAILABLE` (`details.in_service`\nfalse); an event for a bed the matrix does not list (a ward reopened meanwhile): re-fetch the matrix.\n\n**Required permission:** `ipd.bed.view OR cssd.operate OR infection.control.manage`\n\n**Required permission:** `ipd.bed.view OR cssd.operate OR infection.control.manage`",
    "roles_allowed": [
      "admissions_officer",
      "anaesthetist",
      "clinic_director",
      "clinical_specialist",
      "cssd_technician",
      "doctor",
      "head_nurse",
      "hospital_admin",
      "hospital_director",
      "ipc_nurse",
      "ops_admin",
      "owner",
      "receptionist",
      "super_admin",
      "surgeon",
      "triage_nurse",
      "ward_nurse"
    ],
    "parameters": [
