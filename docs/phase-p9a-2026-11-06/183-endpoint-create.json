{
  "method": "POST",
  "path": "/api/v1/patient-feedback",
  "summary": "Record a patient's feedback (Annex A)",
  "tags": [
    "Patient feedback"
  ],
  "permissions": [
    "feedback.record",
    "feedback.review"
  ],
  "permissions_mode": "any",
  "idempotency_key": true,
  "description": "As the respondent gave it: satisfied or not, the reasons from the form's list for that answer (Other with its\ntext), comments. Anonymous unless the respondent agrees to name the visit or the patient. A dissatisfied response\nnotifies the person in charge. `VALIDATION_ERROR` for reasons of the other list, Other without its text, a future\ndate, a visit of another patient or an anonymous response that names someone; `NOT_FOUND` for an unknown visit or\npatient. An id in the request body that does not exist: `REFERENCE_NOT_FOUND` (details.field).\n\n**Required permission:** `feedback.record OR feedback.review`\n\n**Required permission:** `feedback.record OR feedback.review`",
  "roles_allowed": [
    "clinic_director",
    "hospital_admin",
    "hospital_director",
    "owner",
    "quality_officer",
    "receptionist"
  ],
  "parameters": [
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
