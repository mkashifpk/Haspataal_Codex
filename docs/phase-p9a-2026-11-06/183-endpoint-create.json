          "Form",
          "KeyInformant"
        ],
        "title": "Channel",
        "description": "ExitInterview at the end of the visit; Form from the suggestion box or the desk; KeyInformant in the community"
      },
      "respondent": {
        "type": "string",
        "enum": [
          "Patient",
          "Relative",
          "Anonymous",
          "CommunityMember"
        ],
        "title": "Respondent"
      },
      "satisfied": {
        "type": "boolean",
        "title": "Satisfied",
        "description": "Annex A question 1"
      },
      "reasons": {
        "items": {
          "type": "string",
          "enum": [
            "CompleteInformation",
            "AvailableWhenNeeded",
            "NotCostly",
            "ConvenientToReach",
            "CourteousStaff",
            "RelevantStaffAvailable",
            "PrivacyObserved",
            "FemaleStaffAvailable",
            "Recovered",
            "Confidentiality",
            "Privacy",
            "LackOfAttention",
            "InadequateInformation",
            "AskedToComeAgain",
            "Costly",
            "LongWait",
            "DiscourteousStaff",
            "StaffNotCompetent",
            "RelevantStaffNotAvailable",
            "FemaleStaffNotAvailable",
            "SideEffects",
            "Other"
          ]
        },
        "type": "array",
        "maxItems": 13,
        "title": "Reasons",
        "description": "Satisfied: from the YES list; not satisfied: from the NO list"
      },
      "other_reason": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "null"
          }
        ],
        "title": "Other Reason",
        "description": "Required with Other, and only with it"
      },
      "comments": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ],
        "title": "Comments"
      },
      "received_on": {
        "type": "string",
        "format": "date",
        "title": "Received On"
      },
      "ticket_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Ticket Id",
        "description": "The visit it is about, when the respondent agrees to be named (GET /opd-queues/reception-dashboard)"
      },
      "patient_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Patient Id",
        "description": "The patient, when named without a visit; null when anonymous (GET /patients/search)"
      }
    },
    "type": "object",
    "required": [
      "channel",
      "respondent",
      "satisfied",
      "received_on"
