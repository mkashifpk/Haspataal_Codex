{
  "method": "POST",
  "path": "/api/v1/deaths/{death_id}/certify",
  "summary": "Certify the cause of death (final)",
  "tags": [
    "Deaths"
  ],
  "permissions": [
    "death.record"
  ],
  "permissions_mode": "all",
  "idempotency_key": false,
  "description": "Needs Part I (a), the manner, whether the death was expected, surgery in the last four weeks (and its date), the\nexternal cause for an injury, the pregnancy question for a woman of 10-54: otherwise `DEATH_CERTIFICATE_INCOMPLETE`\nwith `details.missing`. Only a doctor registered with the PMDC certifies; the name, designation and PMDC number are\nstamped on it. An unexpected or a maternal death notifies the Quality Officer as a sentinel event.\n`DEATH_CERTIFIER_NOT_DOCTOR`: only a doctor registered with the PMDC can record or certify a death.\n\n`DEATH_RECORD_FINAL`: the death is already certified: append a correction instead.\n\n**Required permission:** `death.record`\n\n**Required permission:** `death.record`",
  "roles_allowed": [
    "anaesthetist",
    "clinical_specialist",
    "doctor",
    "surgeon"
  ],
  "parameters": [
    {
      "name": "death_id",
      "in": "path",
      "required": true,
      "description": "",
      "schema": {
        "type": "integer",
        "title": "Death Id"
      }
    }
  ],
