{
  "method": "POST",
  "path": "/api/v1/patients",
  "summary": "Register a patient (full intake form)",
  "tags": [
    "Patients"
  ],
  "permissions": [
    "patient.create"
  ],
  "permissions_mode": "all",
  "idempotency_key": true,
  "description": "Creates the patient only. To register AND issue an OPD slip + queue in one atomic step use\n`POST /reception/registrations`. Send an `Idempotency-Key` (one per user action, the same on a retry): without one,\na retry after a lost answer creates a second record unless a CNIC or a UPMRN was given.\n`PATIENT_CNIC_EXISTS`, `PATIENT_UPMRN_EXISTS`: a patient with this CNIC or universal patient medical record number\nis registered already: search for them instead.\n\n**Required permission:** `patient.create`\n\n**Required permission:** `patient.create`",
  "roles_allowed": [
    "admissions_officer",
    "receptionist",
    "triage_nurse"
  ],
  "parameters": [
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
  "request_body": {
    "title": "PatientCreate",
    "properties": {
      "full_name": {
        "type": "string",
        "maxLength": 200,
        "minLength": 1,
        "title": "Full Name",
        "examples": [
          "Muhammad Ali"
        ]
      },
      "gender": {
        "type": "string",
        "enum": [
          "male",
          "female",
          "other",
          "unknown"
        ],
        "title": "Gender"
      },
      "dob": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ],
        "title": "Dob"
      },
      "age_years": {
        "anyOf": [
          {
            "type": "integer",
            "maximum": 150,
            "minimum": 0
          },
          {
            "type": "null"
          }
        ],
        "title": "Age Years"
      },
      "mobile": {
        "type": "string",
        "pattern": "^\\+?[0-9][0-9 -]{6,19}$",
        "title": "Mobile",
        "examples": [
          "0300-1234567"
        ]
      },
      "billing_category": {
        "type": "string",
        "enum": [
          "Cash",
          "Panel"
        ],
        "title": "Billing Category",
        "default": "Cash"
      },
      "panel_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Panel Id",
        "description": "The panel (GET /finance/panels)"
      },
      "panel_member_no": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 50
          },
          {
            "type": "null"
          }
        ],
        "title": "Panel Member No"
      },
      "cnic": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9]{5}-?[0-9]{7}-?[0-9]$"
          },
          {
            "type": "null"
          }
        ],
        "title": "Cnic",
        "examples": [
          "35202-1234567-1"
        ]
      },
      "upmrn": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9/-]{3,39}$"
          },
          {
            "type": "null"
          }
        ],
        "title": "Upmrn",
        "description": "The Universal Patient Medical Record Number, once the PHC's HMIS issues one (announced for Category I hospitals; its format is not published yet): optional, unique among active records (PATIENT_UPMRN_EXISTS)"
      },
      "father_or_husband_name": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 200
          },
          {
            "type": "null"
          }
        ],
        "title": "Father Or Husband Name"
      },
      "address": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "null"
          }
        ],
        "title": "Address"
      },
      "emergency_contact_name": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 200
          },
          {
            "type": "null"
          }
        ],
        "title": "Emergency Contact Name"
      },
      "emergency_contact_phone": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 30
          },
          {
            "type": "null"
          }
        ],
        "title": "Emergency Contact Phone"
      },
      "blood_group": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "A+",
              "A-",
              "B+",
              "B-",
              "AB+",
              "AB-",
              "O+",
              "O-",
              "Unknown"
            ]
          },
          {
            "type": "null"
          }
        ],
        "title": "Blood Group"
      },
      "allergies": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 1000
          },
          {
            "type": "null"
          }
        ],
        "title": "Allergies"
      },
      "linked_employee_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Linked Employee Id",
        "description": "Staff member registering as a patient (payroll deduction)"
      }
    },
    "type": "object",
    "required": [
      "full_name",
      "gender",
      "mobile"
    ],
    "description": "Full registration. REQUIRED: full_name, gender, dob OR age_years, mobile, billing_category\n(+ panel_id when billing_category = Panel). Everything else is optional."
