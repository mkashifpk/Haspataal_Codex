{
  "method": "POST",
  "path": "/api/v1/qa/rounds",
  "summary": "Conduct and sign a round",
  "tags": [
    "Quality assurance rounds"
  ],
  "permissions": [
    "qa.round.conduct"
  ],
  "permissions_mode": "all",
  "idempotency_key": true,
  "description": "The in-charge answers every active item of the frequency: Satisfactory, NeedsAttention (with the observation) or\nNotApplicable, with recommendations and the general remarks. The round is signed with the in-charge's stamp and kept\nas signed: correct a mistake in the next round. `VALIDATION_ERROR` for a missing, unknown or repeated item, a\nNeedsAttention without an observation, or a time in the future.\n\n**Required permission:** `qa.round.conduct`\n\n**Required permission:** `qa.round.conduct`",
  "roles_allowed": [
    "clinic_director",
    "hospital_admin",
    "hospital_director",
    "owner",
    "quality_officer"
  ],
  "parameters": [
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
  "request_body": {
    "title": "RoundIn",
    "properties": {
      "frequency": {
        "type": "string",
        "enum": [
          "DailyWeekly",
          "MonthlyQuarterly",
          "StorageQuarterly"
        ],
        "title": "Frequency"
      },
      "conducted_at": {
        "type": "string",
        "format": "date-time",
        "title": "Conducted At",
        "description": "The date and time of the inspection, with timezone (not in the future)"
      },
      "items": {
        "items": {
          "title": "RoundAnswerIn",
          "properties": {
            "item_id": {
              "type": "integer",
              "title": "Item Id"
            },
            "result": {
              "type": "string",
              "enum": [
                "Satisfactory",
                "NeedsAttention",
                "NotApplicable"
              ],
              "title": "Result"
            },
            "observation": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ],
              "title": "Observation",
              "description": "Required when the result is NeedsAttention"
            },
            "recommendation": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ],
              "title": "Recommendation"
            }
          },
          "type": "object",
          "required": [
            "item_id",
            "result"
          ]
        },
        "type": "array",
        "maxItems": 200,
        "minItems": 1,
        "title": "Items",
        "description": "Every active item of the frequency, once (GET /qa/checklist-items)"
      },
      "general_remarks": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4000
          },
          {
            "type": "null"
          }
        ],
        "title": "General Remarks"
      }
    },
    "type": "object",
    "required": [
      "frequency",
      "conducted_at",
      "items"
    ]
  },
  "request_content_type": "application/json",
  "response_schema": {
