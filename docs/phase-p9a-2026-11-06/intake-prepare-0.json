        "title": "Not Maintainable Reason"
      },
      "priority": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "Urgent",
              "High",
              "Normal",
              "Low"
            ]
          },
          {
            "type": "null"
          }
        ],
        "title": "Priority",
        "description": "Urgent: a risk to a patient now; High: harm or a serious failure of care"
      },
      "contact_user_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Contact User Id",
        "description": "The contact person named to the complainant"
      },
      "investigator_user_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Investigator User Id",
        "description": "Who investigates (default: the contact person)"
      },
      "course_of_action": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ],
        "title": "Course Of Action",
        "examples": [
          "The ward sister will speak to the staff on duty and check the nursing notes"
        ]
      },
      "response_due": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ],
        "title": "Response Due",
        "description": "Default: received + complaint_response_days"
      },
      "means": {
        "type": "string",
        "enum": [
          "Telephone",
          "SMS",
          "Letter",
          "Email",
          "InPerson"
        ],
        "title": "Means",
        "description": "How the complainant was told"
      },
      "note": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ],
        "title": "Note",
        "description": "What else was said"
      }
    },
    "type": "object",
    "required": [
      "means"
    ]
  },
