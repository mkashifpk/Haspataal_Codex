{
  "method": "POST",
  "path": "/api/v1/complaints/{complaint_id}/acknowledge",
  "summary": "Acknowledge: the tracking number, the contact person, the course of action",
  "tags": [
    "Complaints"
  ],
  "permissions": [
    "complaint.manage"
  ],
  "permissions_mode": "all",
  "idempotency_key": true,
  "description": "Within `complaint_acknowledge_hours` (MSDS PRE 82 ii a): the priority, the contact person, the investigator\n(default: the contact person), the course of action and the date the outcome is due (default\n`complaint_response_days` after receipt); `means` says how the complainant was told (recorded as an update). Or\n`maintainable` false with the reason. Then print the letter (`GET /complaints/{id}/letter/print-payload`).\n`COMPLAINT_STATE_INVALID`: the complaint cannot change that way: what was complained of, the acknowledgement, the\noutcome and the appeal are recorded once.\n\n**Required permission:** `complaint.manage`\n\n**Required permission:** `complaint.manage`",
  "roles_allowed": [
    "clinic_director",
    "hospital_admin",
    "hospital_director",
    "owner",
    "quality_officer"
  ],
  "parameters": [
    {
      "name": "complaint_id",
      "in": "path",
      "required": true,
      "description": "",
      "schema": {
        "type": "integer",
        "title": "Complaint Id"
      }
    },
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
  "request_body": {
    "title": "ComplaintAcknowledgeIn",
    "properties": {
      "maintainable": {
        "type": "boolean",
