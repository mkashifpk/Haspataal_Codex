{
  "method": "POST",
  "path": "/api/v1/complaints",
  "summary": "Record a complaint",
  "tags": [
    "Complaints"
  ],
  "permissions": [
    "complaint.register"
  ],
  "permissions_mode": "all",
  "idempotency_key": true,
  "description": "As it is made, verbally or in writing (MSDS PRE 80): who complains and how to reach them (a telephone number or an\naddress, except anonymous and suggestion-box complaints), what it concerns (the patient or the admission, the\ndepartment), the category, the complaint in the complainant's words and what they ask for. Give the complainant the\n`complaint_number` at once: it is their tracking number. The complaint managers are notified (`complaint.received`).\nAn id in the request body that does not exist: `REFERENCE_NOT_FOUND` (details.field).\n\n**Required permission:** `complaint.register`\n\n**Required permission:** `complaint.register`",
  "roles_allowed": [
    "admissions_officer",
    "anaesthetist",
    "cashier",
    "clinic_director",
    "clinical_specialist",
    "doctor",
    "head_nurse",
    "hospital_admin",
    "hospital_director",
    "owner",
    "pharmacist",
    "quality_officer",
    "receptionist",
    "surgeon",
    "triage_nurse",
    "ward_nurse"
  ],
  "parameters": [
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
  "request_body": {
    "title": "ComplaintIn",
    "properties": {
      "channel": {
        "type": "string",
        "enum": [
          "InPerson",
          "Telephone",
          "Letter",
          "Email",
          "SuggestionBox",
          "HealthCommission",
          "SocialMedia",
          "Other"
        ],
        "title": "Channel"
      },
      "complainant_name": {
        "type": "string",
        "maxLength": 200,
        "minLength": 2,
        "title": "Complainant Name",
        "description": "Anonymous complaints: 'Anonymous'"
      },
      "complainant_relation": {
        "type": "string",
        "enum": [
          "Patient",
          "Relative",
          "Attendant",
          "Visitor",
          "Staff",
          "Anonymous",
          "Other"
        ],
        "title": "Complainant Relation"
      },
      "complainant_phone": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 30
          },
          {
            "type": "null"
          }
        ],
        "title": "Complainant Phone"
      },
      "complainant_contact": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "null"
          }
        ],
        "title": "Complainant Contact",
        "description": "Address or e-mail for a written answer"
      },
      "preferred_means": {
        "type": "string",
        "enum": [
          "Telephone",
          "SMS",
          "Letter",
          "Email",
          "InPerson"
        ],
        "title": "Preferred Means",
        "description": "How the complainant wants to be kept informed",
        "default": "Telephone"
      },
      "patient_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Patient Id",
        "description": "The patient (GET /patients/search)"
      },
      "admission_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Admission Id",
        "description": "The admission it concerns (the patient follows from it) (GET /admissions?status=Admitted)"
      },
      "department_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Department Id",
        "description": "The department (GET /admin/departments)"
      },
      "ward_id": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Ward Id",
        "description": "The ward (GET /beds/matrix?include_beds=false)"
      },
      "category": {
        "type": "string",
        "enum": [
          "ClinicalCare",
          "NursingCare",
          "StaffAttitude",
          "Communication",
          "WaitingTime",
          "Billing",
          "Cleanliness",
          "Food",
          "Facilities",
          "Privacy",
          "Safety",
          "Medication",
          "Diagnostics",
          "Other"
        ],
        "title": "Category"
      },
      "description": {
        "type": "string",
        "maxLength": 8000,
        "minLength": 10,
        "title": "Description",
        "description": "The complaint in the complainant's words"
      },
      "desired_outcome": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 2000
          },
          {
            "type": "null"
          }
        ],
        "title": "Desired Outcome",
        "description": "What the complainant asks for"
      }
    },
    "type": "object",
    "required": [
      "channel",
      "complainant_name",
      "complainant_relation",
      "category",
      "description"
    ]
  },
  "request_content_type": "application/json",
