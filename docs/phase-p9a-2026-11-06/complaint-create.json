  "recorded_example": {
    "request": {
      "path": "/api/v1/complaints",
      "body": {
        "channel": "InPerson",
        "complainant_name": "Shahid Mehmood",
        "complainant_relation": "Relative",
        "complainant_phone": "03001112233",
        "category": "WaitingTime",
        "description": "My father waited four hours in the OPD although he had a token for 10 o'clock",
        "desired_outcome": "An apology, and a fixed time for his next visit",
        "patient_id": 1,
        "department_id": 1
      }
    },
    "response": {
      "status": 201,
      "body": {
        "data": {
