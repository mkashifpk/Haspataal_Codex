{
  "method": "PUT",
  "path": "/api/v1/deaths/{death_id}",
  "summary": "Write the cause-of-death certificate (draft)",
  "tags": [
    "Deaths"
  ],
  "permissions": [
    "death.record"
  ],
  "permissions_mode": "all",
  "idempotency_key": false,
  "description": "Only the fields sent change (send `row_version` as `expected_version`). Part I is one chain: a line needs the line\nabove it. A certified record answers `DEATH_RECORD_FINAL`.\n`DEATH_TIME_INVALID`: the time of death cannot be in the future.\n\n`ICD_CODE_UNKNOWN`: a code that is not in the loaded ICD list: pick codes from the ICD picker.\n\n**Required permission:** `death.record`\n\n**Required permission:** `death.record`",
  "roles_allowed": [
    "anaesthetist",
    "clinical_specialist",
    "doctor",
    "surgeon"
  ],
  "parameters": [
    {
      "name": "death_id",
      "in": "path",
      "required": true,
      "description": "",
      "schema": {
        "type": "integer",
        "title": "Death Id"
      }
    }
  ],
  "request_body": {
