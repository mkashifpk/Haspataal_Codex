{
  "method": "POST",
  "path": "/api/v1/complaints/{complaint_id}/appeal",
  "summary": "Record an appeal",
  "tags": [
    "Complaints"
  ],
  "permissions": [
    "complaint.register",
    "complaint.manage"
  ],
  "permissions_mode": "any",
  "idempotency_key": true,
  "description": "Within the window the outcome gave (`COMPLAINT_APPEAL_LATE` after it). The appeal deciders are notified.\n\n`COMPLAINT_STATE_INVALID`: only a Resolved complaint is appealed.\n\n**Required permission:** `complaint.register OR complaint.manage`\n\n**Required permission:** `complaint.register OR complaint.manage`",
  "roles_allowed": [
    "admissions_officer",
    "anaesthetist",
    "cashier",
    "clinic_director",
    "clinical_specialist",
    "doctor",
    "head_nurse",
    "hospital_admin",
    "hospital_director",
    "owner",
    "pharmacist",
    "quality_officer",
    "receptionist",
    "surgeon",
    "triage_nurse",
    "ward_nurse"
  ],
  "parameters": [
    {
      "name": "complaint_id",
      "in": "path",
      "required": true,
      "description": "",
      "schema": {
        "type": "integer",
        "title": "Complaint Id"
      }
    },
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
  "request_body": {
    "title": "AppealIn",
    "properties": {
      "appeal_text": {
        "type": "string",
        "maxLength": 8000,
        "minLength": 10,
        "title": "Appeal Text",
        "description": "Why the complainant disagrees"
      },
      "means": {
        "type": "string",
        "enum": [
          "Telephone",
          "SMS",
          "Letter",
          "Email",
          "InPerson"
        ],
        "title": "Means",
        "description": "How the appeal came"
      }
    },
    "type": "object",
    "required": [
      "appeal_text",
      "means"
    ]
  },
