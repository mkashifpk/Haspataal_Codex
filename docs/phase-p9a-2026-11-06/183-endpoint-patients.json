{
  "method": "GET",
  "path": "/api/v1/patients/search",
  "summary": "Returning-patient lookup by name / phone / CNIC / UPMRN / MRN",
  "tags": [
    "Patients"
  ],
  "permissions": [
    "patient.search"
  ],
  "permissions_mode": "all",
  "idempotency_key": false,
  "description": "Each hit includes `outstanding` → show the red **OUTSTANDING BALANCE: RS. X** banner when\n`has_outstanding_ar` is true (workflow §1.2).\n\n`q` is an MRN or UPMRN (exact, any case: a scanned slip), a mobile number (7 digits or more: the last 10 are\ncompared), a CNIC (13 digits, dashes or not) or a part of the name. A name may contain digits (the trauma label \"Unknown\nMale 3\"): any term with a letter is also looked for in the names; a term of digits alone is only a number.\n\nMerged profiles are matched too, and each person comes back once, as their master record: the MRN on an old slip,\na trauma label or a merged duplicate's name or numbers find the master, with `matched_merged_profile` naming the\nmerged profile that matched (null when the master itself did). The best match comes first: an exact MRN, then the\nclosest name. `VALIDATION_ERROR`: fewer than 2 characters once the spaces are trimmed.\n\n**Required permission:** `patient.search`\n\n**Required permission:** `patient.search`",
  "roles_allowed": [
    "accountant",
    "admissions_officer",
    "anaesthetist",
    "billing_admin",
    "cashier",
    "clinic_director",
    "clinical_specialist",
    "doctor",
    "head_nurse",
    "hospital_admin",
    "hospital_director",
    "ipc_nurse",
    "lab_technician",
    "lab_verifier",
