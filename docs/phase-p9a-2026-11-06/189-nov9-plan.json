  "delivery_gate": {
    "required": true,
    "status": "required",
    "progress_reporting": {
      "required": true,
      "submit": "propose_progress",
      "verify": "progress_proposals",
      "when": "After each implemented screen, before switching workspace or handoff. Propose only tested items; identify the build and limitations. Do not duplicate unchanged pending/accepted work. Human approval still required."
    },
    "rule": "A screen or workspace is unfinished until its working UI, F1 contextual help, English/Urdu screen handbook,\nworkspace guide and detailed FAQ for every supported role, bounded 100-250% keyboard zoom, frontend coverage checks,\nand named human review of fresh, newly created data and supported CRUD operations are complete. Follow the workspace review\nchecklist (guide 17). Missing evidence stays pending; seeded-demo browsing, API tests or screenshots alone do not\nestablish completion. Agents propose evidence; only authenticated human review accepts progress.",
    "compulsory": [
      {
        "id": "q:f1_help",
        "label": "F1 contextual help",
        "what": "F1 opens the correct permitted help, including from fields/dialogs, preserves unsaved work and restores focus. Visible Help also works; login/locked/kiosk help exposes only public/operator guidance.",
        "points": 2
      },
      {
        "id": "q:role_faq",
        "label": "Complete role-specific FAQs",
        "what": "Every supported role task in this workspace, including shared screens and handovers, has a detailed reviewed English/Urdu FAQ. Follow get_handbook_outline; a generic FAQ or an unreviewed role journey is unfinished.",
        "points": 3
      },
      {
        "id": "q:zoom",
        "label": "Keyboard zoom: 100-250% only",
        "what": "Ctrl++/Ctrl+=, Ctrl+- and Ctrl+0 (Command on macOS), Settings and all enabled zoom routes share one state clamped to 100-250%. Test both bounds, reset, persistence and usable English/Urdu layouts at 250%.",
        "points": 2
      },
      {
        "id": "q:fresh_data",
        "label": "Human review with newly created data",
        "what": "A named human follows guide 17 on this build: creates new synthetic records through the UI and verifies read, update/correction and permitted delete/cancel/deactivate paths, refusal paths and handovers. Read-only screens use fresh upstream records. Record IDs and evidence; pre-existing demo data alone is insufficient.",
        "points": 4
      }
    ],
    "zoom": {
      "min_pct": 100,
      "max_pct": 250,
      "reset_pct": 100,
      "keys": [
        "Ctrl + or Ctrl = (zoom in)",
        "Ctrl - (zoom out)",
        "Ctrl 0 (reset to 100 %)",
        "Command on macOS"
      ],
      "one_state": "The keys, the Settings slider and any menu, wheel or pinch zoom move ONE zoom state, clamped to 100.0-250.0 %, saved as ui_scale_pct (PUT /settings/me) and restored at login (/auth/me preferences). Electron: webContents.setZoomFactor(pct / 100)."
    },
    "workspace_done_when": "Every screen of the workspace has every compulsory item above, in addition to its endpoints, events and rules: F1 contextual Help, a detailed FAQ for every role of the workspace (English and Urdu), the bounded keyboard zoom and a named human's review with newly created data (get_guide('workspace-review-checklist')), signed on the portal. Missing any one, the workspace is NOT done: report it as pending, never as complete.",
    "read": "get_ui_quality_brief(screen_id=...) or get_ui_quality_brief(workspace=...)"
  },
  "handbook_page": "screens/adr_report",
  "workspace_guide": "get_handbook_outline('quality')",
  "realtime": [
    {
      "event": "incident.updated",
      "check": "the screen refreshes without polling"
    }
  ],
  "acceptance_rules": [
    "Offer 'ADR report' only on an incident of the type ADVERSE_DRUG_REACTION (INCIDENT_NOT_ADR otherwise).",
    "GET first: saved false shows the draft Haspataal could fill (the medicine's name, ingredients and form, the date it was reported). The product's registration number, pack size, manufacturer and manufacture date come from the pack: type them; never invent them.",
    "Pick the batch from the medicine's stock batches when it was dispensed here (batch_id fills the number and the expiry); for a medicine bought outside type them.",
    "Save = PUT (send expected_version once saved). The reporting person is the user who first saves it: their name, post and registration print on the form; the signature is by hand.",
    "'Mark as sent': DRAP, Manufacturer, Supplier (the manual asks for all three), with the date and the reference; once each (ADR_REPORT_ALREADY_SENT). After the first sending the form is locked (ADR_REPORT_SENT): show it read-only with the list of where it went.",
    "Print = GET /incidents/{id}/adr-report/pdf, the manual's form filled in."
  ],
  "demo_accounts": "demo_accounts() lists a login per role; sandbox_call runs each case on the DEV server"
}
