{
  "method": "POST",
  "path": "/api/v1/patients/{patient_id}/death",
  "summary": "Record a death",
  "tags": [
    "Deaths"
  ],
  "permissions": [
    "death.record"
  ],
  "permissions_mode": "all",
  "idempotency_key": true,
  "description": "The doctor who confirms the death records it at once (a doctor registered with the PMDC:\n`DEATH_CERTIFIER_NOT_DOCTOR`). The patient is deceased from now on: any later clinical entry is flagged for review,\nand the ward and registers get `death.recorded`. An inpatient death belongs to the current admission\n(`DEATH_ADMISSION_NOT_ACTIVE` without one), and an admitted patient's death is always an inpatient death\n(`DEATH_SETTING_INVALID`); a body brought dead needs `arrived_at`. The medico-legal case of the stay\nor visit, or the patient's only open one, is linked unless `mlc_id` is sent. The certificate fields may be sent now\nor later with PUT; the record stays a Draft until certified.\n`DEATH_TIME_INVALID`: the time of death cannot be in the future; `PATIENT_ALREADY_DECEASED`: the patient's death is\nalready recorded; `PATIENT_MERGED_CANNOT_TRANSACT`: this patient record was merged; use the master record.\n\n`ICD_CODE_UNKNOWN`: a code that is not in the loaded ICD list: pick codes from the ICD picker.\n\n**Required permission:** `death.record`\n\n**Required permission:** `death.record`",
  "roles_allowed": [
    "anaesthetist",
    "clinical_specialist",
    "doctor",
    "surgeon"
  ],
  "parameters": [
    {
      "name": "patient_id",
      "in": "path",
      "required": true,
      "description": "",
      "schema": {
        "type": "integer",
        "title": "Patient Id"
      }
    },
    {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "description": "Unique per logical action; retries return the first result",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Unique per logical action; retries return the first result",
        "title": "Idempotency-Key"
      }
    }
  ],
